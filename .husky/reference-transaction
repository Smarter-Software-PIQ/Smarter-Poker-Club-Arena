#!/usr/bin/env bash
# Prevent a ref transaction from making local commits unreachable.
#
# This hook is deliberately preventive and read-only. It does not stash,
# snapshot, create rescue refs, reconcile state, or repair an operation after
# the fact. The working-tree root control is one isolated worktree per agent;
# this hook is the final fail-closed boundary for committed work.
#
# stdin: <old-object> SP <new-object> SP <ref-name> LF
set -u

[ "${1:-}" = "prepared" ] || exit 0

ZERO=0000000000000000000000000000000000000000

while read -r OLD NEW REF; do
  # ONE STASH LIST FOR EVERY WORKTREE (2026-11-21). refs/stash lives in the
  # common git directory, so every worktree of a clone pushes onto and pops
  # off the SAME list. On 2026-11-21 two agents stashed in two worktrees at
  # once and each popped the other's changes into its own tree. A stash push
  # stores refs/stash BEFORE it resets the tree, so refusing it here leaves
  # the working tree exactly as it was (measured on git 2.43 and Apple git
  # 2.50.1). Removing an entry (pop or drop of the last one) is still allowed
  # so an old list can be drained. Commit to your own branch instead.
  if [ "$REF" = "refs/stash" ]; then
    [ "$NEW" != "$ZERO" ] || continue
    {
      echo
      echo "  BLOCKED: this repository refuses new stash entries."
      echo
      echo "  Every worktree of this clone shares ONE stash list, so another"
      echo "  agent's pop can take your changes, and yours can take theirs."
      echo "  Your working tree is untouched. Commit the changes on your own"
      echo "  branch in your own worktree instead (CLAUDE.md 10.87 rule 5)."
      echo
    } >&2
    exit 1
  fi

  case "$REF" in
    HEAD|refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac

  [ "$OLD" != "$ZERO" ] || continue
  [ "$OLD" != "$NEW" ] || continue

  if [ "$NEW" = "$ZERO" ]; then
    CANDIDATE=$(git rev-list --max-count=1 "$OLD" --not --exclude="$REF" --all 2>/dev/null || true)
    ORPHANED=$(git log --oneline --max-count=20 "$OLD" --not --exclude="$REF" --all 2>/dev/null || true)
  else
    CANDIDATE=$(git rev-list --max-count=1 "$OLD" --not "$NEW" --exclude="$REF" --all 2>/dev/null || true)
    ORPHANED=$(git log --oneline --max-count=20 "$OLD" --not "$NEW" --exclude="$REF" --all 2>/dev/null || true)
  fi
  [ -n "$CANDIDATE" ] || continue
  {
    echo
    echo "  BLOCKED: this ref update would make local commits unreachable."
    echo
    printf '%s\n' "$ORPHANED" | sed 's/^/    /'
    echo
    echo "  Create or push a branch that contains the commits, then retry."
    echo "  No hook-created snapshot or recovery ref was written."
    echo
  } >&2
  exit 1
done

exit 0
