#!/usr/bin/env bash
# Club Arena pre-push hook — Phase 6 consolidation gate (2026-04-27)
#
# Blocks pushes that:
#   1. Contain merge-conflict markers (lesson from f490f61bf)
#   2. Introduce vercel.json crons (Open Claw exclusive policy)
#   3. Introduce client-side PIN-gate storage (Phase 3.6 server-side only)
#   4. Use raw supabase.auth.getUser() outside src/lib/authUtils.ts
#
# There is no bypass. A refusal must be fixed at its source.

set -e

# ── A HOOK'S GIT ENVIRONMENT NEVER REACHES THE TESTS (2026-11-07) ───────────
# Git exports GIT_DIR (and, from a linked worktree, GIT_COMMON_DIR and
# friends) to every hook it runs. Each one is an absolute pointer at THIS
# repository's metadata. A test that spawns `git` anywhere else - a disposable
# fixture under $TMPDIR, or the engine's benchmark readers running from
# server/ - inherits that pointer and fails with "fatal: this operation must
# be run in a work tree", a verdict about the environment that reads as a
# verdict about the change. Measured 2026-11-07: a workflow-only push from a
# Mac worktree was refused by eleven server benchmark cases that pass in every
# other environment. Git finds this tree on its own from the hook's working
# directory, so nothing below needs these; the tests must not see them.
# The same inheritance flipped the shared clone to core.bare=true twice that
# day: `git -C <tmp> init` under an inherited worktree GIT_DIR re-initialised
# THIS repository, guessed "bare" and wrote it into the shared config
# (scripts/guard-bare-flip.sh), which then refuses a clone left in that state.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
bash "$(git rev-parse --show-toplevel)/scripts/guard-bare-flip.sh"

# ── One working tree per agent (rule 1a) ────────────────────────────────────
# Runs FIRST, for the same reason it runs first on pre-commit: if this push
# should not be coming from this tree at all, none of the content checks below
# matter. No publisher or agent pushes from the shared clone.
#
# Added 2026-08-23. Commit-only enforcement missed the shape that actually
# loses work: an agent edits in the shared clone, never commits there, and the
# next checkout or `git reset --hard` takes the lot with nobody warned.
bash "$(git rev-parse --show-toplevel)/scripts/guard-shared-clone.sh" push

# ── The pull request for this branch may already be MERGED (2026-09-06) ─────
# Autopilot squash-merges the instant the required checks pass. A push after
# that lands on a closed pull request, changes nothing, and EXITS 0 - which is
# how World Hub #1387 shipped one of its three commits and nobody noticed for
# hours. The actual remote destination is checked inside the ref loop below.
# Warns, never blocks. The disk filling is the one failure on this machine
# that presents as somebody else's bug (see scripts/worktree-pressure.sh).
bash "$(git rev-parse --show-toplevel)/scripts/worktree-pressure.sh" || true

# ── THE CLONE YOU ARE NOT PUSHING FROM IS THE ONE THAT ROTS (2026-09-12) ────
#
# Every guard in this hook protects the tree being pushed. Nothing protected
# ~/Documents/club-arena, because `guard-shared-clone.sh` above forbids pushing
# from it - so the canonical clone, the one every Cowork agent is pointed at
# and reads CLAUDE.md and .claude/skills/ out of, is the single tree no
# pre-push check ever looked at.
#
# On 2026-09-12 it was 759 commits and six days behind origin/main. A commit
# made directly on local `main` on 2026-09-06 was never pushed, so every
# `git pull --ff-only` after it refused, and the estate runs that as
# `pull -q --ff-only`. Three agents read that tree, believed it was production,
# and were wrong: the deploy-hetzner skill on disk still named the TURN server
# as the engine, and CLAUDE.md 10.82 still documented a guard bypass that had
# been deleted.
#
# `agent-workspace.sh` had already hit this on 2026-09-11 at 624 commits and
# worked around it. Nobody measured it, so it kept drifting.
#
# ADVISORY, never blocking. A stale clone somewhere else on the machine is not
# a reason to refuse THIS push from a fresh worktree, and
# tests/unit/doctrineIsReadFromMain.test.ts is explicit that a freshness guard
# which can wedge every push is worse than the staleness. --quiet prints
# nothing when every clone is current, and skips the worktree census.
bash "$(git rev-parse --show-toplevel)/scripts/check-checkout-freshness.sh" --quiet || true

REMOTE="$1"
URL="$2"
FAIL=0

# ── node must be findable, and a missing node must not masquerade as a
# content failure (2026-08-23).
#
# A push from a shell without /opt/homebrew/bin on PATH ran
# `node scripts/ci/check-title-case.mjs`, which exited 127 command-not-found,
# and this hook announced:
#
#     check-title-case FAILED: page copy is not Title Cased.
#
# The copy was fine; node was absent. The agent's commit stayed unpushed -
# the one state this estate cannot afford - and the message sent them to look
# at the wrong thing entirely. The REAL blocker on that push only became
# visible once node was found: a genuine supabase.auth.getUser() violation,
# which check 4 below then reported correctly. A false failure had been
# standing in front of a true one.
#
# World Hub's Club Arena bundle gate had the identical bug the same day,
# announcing "STALE or INCOMPLETE bundle" when node was simply missing
# (WH #664).
#
# node's DIRECTORY goes on PATH rather than resolving a single binary, so that
# child processes inherit it too - npx is itself a node script and fails its
# own shebang with `env: node: No such file or directory` otherwise.
# THE SAME BUG THEN HAPPENED TO `gh` (2026-09-12), because this repair named
# ONE tool instead of the set the guards need.
#
# `scripts/guard-merged-branch.sh` was rewritten to fail CLOSED on a missing
# `gh` - correctly: a guard that waves a push through when it cannot reach
# GitHub is how three commits were lost on World Hub #1387. But `gh` lives in
# /opt/homebrew/bin, which is NOT on a non-interactive PATH on this Mac, and
# the node repair above only reached that directory when node was ALSO
# missing. Every agent that follows CLAUDE.md 11.0 and puts nvm's node on PATH
# therefore satisfies the node check, never triggers the repair, and gets:
#
#     [merged-branch guard] BLOCKED: GitHub CLI is required to verify
#     destination branch '<branch>'.
#
# on a push that was never wrong. Reproduced 2026-09-12:
#
#     $ env -i PATH="$HOME/.nvm/versions/node/v24.15.0/bin:/usr/bin:/bin" bash
#     $ command -v node   ->  .../v24.15.0/bin/node     (repair skipped)
#     $ command -v gh     ->  (nothing)                 (guard fails closed)
#
# The docs said "`gh` is not installed" for days, which is the RIGHT
# OBSERVATION with the WRONG CAUSE: it is installed (v2.86.0, authenticated),
# it is simply not on this PATH. So repair the whole SET, and let
# `tests/the-docs-describe-this-environment.law.test.ts` fail if a guard ever
# starts requiring a tool that is not in this list.
# APPENDED, not prepended. Prepending /opt/homebrew/bin to find `gh` would
# also put Homebrew's node ahead of the nvm node the agent deliberately chose,
# silently changing which runtime runs the checks below. Appending finds the
# missing tool and leaves every tool that already resolved exactly where it was.
for TOOL in node gh; do
  command -v "$TOOL" >/dev/null 2>&1 && continue
  for d in /opt/homebrew/bin /usr/local/bin; do
    [ -x "$d/$TOOL" ] && PATH="$PATH:$d" && export PATH && break
  done
done
if ! command -v node >/dev/null 2>&1; then
  echo "[club-arena pre-push] BLOCKED: node was not found on PATH, so the"
  echo "  JavaScript checks below cannot run. This is NOT a content failure."
  echo "  Re-run with node available, for example:"
  echo "      PATH=\"/opt/homebrew/bin:\$PATH\" git push -u origin HEAD"
  exit 1
fi

# ── THE MAC RUNS THE CHECKS THE WAY CI DOES (2026-11-05) ───────────────────
#
# On 2026-11-05 every server push from the Mac Studio was refused by tests
# that pass in CI and also failed on an untouched origin/main checkout, so an
# agent could not push an engine change from this machine at all. Three
# causes, all environment, none content:
#
#   1. Node. Homebrew's node on this Mac is 26 (nvm also holds 20, 22, 24);
#      CI and the engine run 22. Node 26 prints a module.register()
#      DeprecationWarning that tests asserting a silent stderr read as failure.
#   2. TMPDIR. macOS points it at /var/folders on the boot drive. The Phase 14
#      fleet tests refuse anything but an owned external-SSD scratch
#      directory, and a long TMPDIR makes PostgreSQL's Unix socket name too
#      long for the money fixtures.
#   3. The native evaluator (server/native/build/public_hist215_wtl.node) is
#      built, not committed - CI builds it in `pretest` - so a fresh worktree
#      has none (handled with the server tests below).
#
# So on macOS this hook runs Node 22 when the shell's node is another major,
# and gives the run its own short TMPDIR on the external SSD. Nothing changes
# on Linux, and a TMPDIR the caller already placed on /Volumes is kept.
#
# SCRATCH THAT STAYS PUT (2026-11-07). A push's TMPDIR vanished mid-run. The
# cause was the drive, not a sweeper: SmarterWork dropped and came back as
# "/Volumes/SmarterWork 1", because a nested mount (extreme-capacity) had
# recreated /Volumes/SmarterWork as a read-only folder on the boot disk. The
# old setup then failed its mkdir silently, kept the caller's TMPDIR, and the
# Bash shim refused with a vague message (its `awk $NF` mount parse also broke
# on the space in "SmarterWork 1"). Now: the mountpoint is read whole; a
# scratch path on the boot disk is refused up front with the reason and, when
# the drive is under a renamed mountpoint, where it went; each run marks its
# directory with its PID so the day-old sweep never takes a live run's; and a
# TMPDIR that vanishes during the run is named at exit as an environmental
# failure. The path stays short (PostgreSQL socket limit), so the hook never
# falls back to the renamed mountpoint with a space in it.
CA_PUSH_TMP=""
if [ "$(uname -s)" = Darwin ]; then
  ca_mount_of() {
    ca_path=$1
    while [ ! -e "$ca_path" ] && [ "$ca_path" != / ]; do ca_path=$(dirname -- "$ca_path"); done
    # The mountpoint is everything after the capacity column, spaces included.
    df -P -- "$ca_path" 2>/dev/null | awk 'END { m = $NF; for (i = 1; i < NF; i++) if ($i ~ /%$/) { m = $(i + 1); for (j = i + 2; j <= NF; j++) m = m " " $j; break } print m }'
  }
  CA_VOLUMES=${CA_VOLUMES:-/Volumes}
  ca_scratch_problem() {
    ca_mount=$(ca_mount_of "$1")
    case "$ca_mount" in
      "$CA_VOLUMES"/?*) return 0 ;;
    esac
    printf '%s is on the boot disk (its filesystem is mounted at %s), not on an external drive.' "$1" "${ca_mount:-?}"
    case "$1" in
      "$CA_VOLUMES"/?*)
        ca_vol=${1#"$CA_VOLUMES"/}
        ca_vol=$CA_VOLUMES/${ca_vol%%/*}
        for ca_moved in "$ca_vol "[0-9]*; do
          [ -d "$ca_moved" ] || continue
          case "$(ca_mount_of "$ca_moved")" in
            "$ca_moved")
              printf ' The drive is mounted at "%s" instead: it came back under another name while a stale %s folder held its place. Clear the stale folder and remount the drive at %s before pushing.' "$ca_moved" "$ca_vol" "$ca_vol"
              ;;
          esac
        done
        ;;
    esac
    return 1
  }
  # Remove day-old run directories under $1, except $2 and any whose owning
  # push is still alive.
  ca_sweep_runs() {
    for ca_old in "$1"/p.*; do
      [ -d "$ca_old" ] && [ "$ca_old" != "$2" ] || continue
      ca_owner=$(cat "$ca_old/.ca-push-owner" 2>/dev/null || true)
      if [ -n "$ca_owner" ] && kill -0 "$ca_owner" 2>/dev/null; then continue; fi
      if [ -n "$(find "$ca_old" -maxdepth 0 -mtime +1 2>/dev/null)" ]; then rm -rf -- "$ca_old"; fi
    done
  }
  # A WRITABLE TMPDIR, NOT JUST AN EXTERNAL ONE (2026-11-07). A caller's
  # TMPDIR on /Volumes used to be kept on its path alone. Agents inherit one
  # under /Volumes/SmarterWork/agent-work/..., and while SmarterWork is the
  # read-only root stub (the drive under "SmarterWork 1") that path cannot be
  # created or written: vitest's first mkdtemp died with EACCES and the push
  # was refused for the environment, not the content. Keep a caller's TMPDIR
  # only when this run can make a directory in it; otherwise say so and take
  # this run's own scratch below, exactly as for a boot-disk TMPDIR.
  ca_dir_writable() {
    [ -d "$1" ] && [ -w "$1" ] || return 1
    ca_probe=$(mktemp -d "$1/.ca-probe.XXXXXX" 2>/dev/null) || return 1
    rmdir "$ca_probe" 2>/dev/null || true
  }
  if [ "${TMPDIR#/Volumes/}" != "${TMPDIR:-}" ] && ! ca_dir_writable "$TMPDIR"; then
    echo "[club-arena pre-push] note: TMPDIR $TMPDIR cannot be written; this run uses its own external scratch instead." >&2
    TMPDIR=""
  fi
  case "${TMPDIR:-}" in
    /Volumes/*) ;;
    *)
      # An explicit CA_PUSH_TMP_ROOT is the only candidate. Otherwise take the
      # first short external root: SmarterWork itself, then the SSD2-Work
      # volume mounted inside it, which stays reachable at a short path even
      # while SmarterWork is under a renamed mountpoint.
      ca_why=""
      CA_PUSH_TMP_PICKED=""
      for ca_root in ${CA_PUSH_TMP_ROOT:-${CA_PUSH_TMP_ROOTS:-/Volumes/SmarterWork/agent-work/.t /Volumes/SmarterWork/agent-work/extreme-capacity/.t}}; do
        if ca_root_why=$(ca_scratch_problem "$ca_root"); then
          # External is not enough: a root-owned stub on the drive is too.
          if mkdir -p "$ca_root" 2>/dev/null && [ -w "$ca_root" ]; then
            CA_PUSH_TMP_PICKED=$ca_root
            break
          fi
          ca_root_why="$ca_root is external but cannot be created or written."
        fi
        ca_why="${ca_why:+$ca_why }$ca_root_why"
      done
      if [ -z "$CA_PUSH_TMP_PICKED" ]; then
        echo "[club-arena pre-push] BLOCKED: external scratch unavailable for this run. $ca_why" >&2
        exit 1
      fi
      CA_PUSH_TMP_ROOT=$CA_PUSH_TMP_PICKED
      if ! mkdir -p "$CA_PUSH_TMP_ROOT" || ! CA_PUSH_TMP=$(mktemp -d "$CA_PUSH_TMP_ROOT/p.XXXXXX"); then
        echo "[club-arena pre-push] BLOCKED: could not create a run directory under $CA_PUSH_TMP_ROOT." >&2
        exit 1
      fi
      echo "$$" >"$CA_PUSH_TMP/.ca-push-owner"
      # Runs are a day old at most. A directory whose owning push is still
      # alive is never swept, whatever its age.
      ca_sweep_runs "$CA_PUSH_TMP_ROOT" "$CA_PUSH_TMP"
      TMPDIR="$CA_PUSH_TMP"
      export TMPDIR
      ;;
  esac
  if ! ca_why=$(ca_scratch_problem "${TMPDIR:-/nonexistent}"); then
    echo "[club-arena pre-push] BLOCKED: external scratch unavailable for TMPDIR. $ca_why" >&2
    exit 1
  fi
  # RUNNER_TEMP (2026-11-07). Tests that run in CI write under RUNNER_TEMP and
  # fall back to a fixed /Volumes/SmarterWork/agent-work path on this Mac,
  # which is now a read-only stub (privateRecordHosting failed every push).
  # Unless the caller gave a writable external one, they share this run's
  # private scratch.
  if [ -z "${RUNNER_TEMP:-}" ] || [ ! -d "$RUNNER_TEMP" ] || [ ! -w "$RUNNER_TEMP" ] \
    || ! ca_scratch_problem "$RUNNER_TEMP" >/dev/null; then
    RUNNER_TEMP=$TMPDIR
  fi
  export RUNNER_TEMP
  # PYTHON (2026-11-07). macOS ships python3 3.9; CI runs 3.11 or newer.
  # Three checks that pass in CI refused every push of an engine change from
  # this Mac, for one reason that is environment and not content: the guards
  # spawn `python3` from PATH, and on a non-interactive PATH that is
  # /usr/bin/python3 (3.9.6). 3.9 has no `tomllib` and no
  # `unittest.TestCase.enterContext` (both 3.11), so
  # tests/engine-release-seal.law.test.ts failed on the import and the
  # attribute. It also reads the refill worker journal differently. Measured
  # on the same input and the same script
  # (scripts/ci/inspect-tournament-refill.py, worker_receipt_errors):
  #     3.9.6   -> {"matchingRecords": 0, "events": []}
  #     3.14.2  -> {"matchingRecords": 1, "events": [{...reference_shape...}]}
  # tests/unit/inspectTournamentRefill.test.ts asserts the second.
  # Same shape as the Bash shim below: a private directory holding only that
  # one link, so no other tool's resolution moves. It runs BEFORE the Bash
  # shim so the bash shim stays FIRST on PATH -
  # tests/the-mac-push-runs-the-checks-like-ci.law.test.ts pins that. TMPDIR
  # is already proven external above, so this needs no scratch check of its
  # own. The LOWEST installed 3.11+ is chosen, to stay as close to CI's
  # interpreter as this Mac allows; CA_PYTHON_CANDIDATES overrides the list.
  CA_PY_WAS=$(python3 -V 2>&1 || echo "no python3")
  CA_PY_RANK_NOW=$(python3 -c 'import sys; print("%d%03d" % sys.version_info[:2])' 2>/dev/null || echo 0)
  if [ "${CA_PY_RANK_NOW:-0}" -lt 3011 ]; then
    CA_PY=""
    CA_PY_RANK=999999
    for ca_c in ${CA_PYTHON_CANDIDATES:-/opt/homebrew/bin/python3.11 /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3.13 /opt/homebrew/bin/python3.14 /opt/homebrew/bin/python3 /usr/local/bin/python3}; do
      [ -x "$ca_c" ] || continue
      ca_r=$("$ca_c" -c 'import sys; print("%d%03d" % sys.version_info[:2])' 2>/dev/null || echo 0)
      [ "$ca_r" -lt 3011 ] && continue
      if [ "$ca_r" -lt "$CA_PY_RANK" ]; then CA_PY_RANK=$ca_r; CA_PY=$ca_c; fi
    done
    if [ -z "$CA_PY" ]; then
      echo "[club-arena pre-push] BLOCKED: python3 on PATH is $CA_PY_WAS, older"
      echo "  than the 3.11 the Python guards below need, and no 3.11-or-newer"
      echo "  interpreter was found. This is NOT a content failure. Install one,"
      echo "  for example:  brew install python@3.13"
      exit 1
    fi
    CA_PY_DIR=$(mktemp -d "$TMPDIR/club-arena-pre-push-python.XXXXXX") || exit 1
    if ! ln -s "$CA_PY" "$CA_PY_DIR/python3"; then rmdir "$CA_PY_DIR"; exit 1; fi
    PATH="$CA_PY_DIR:$PATH"
    export PATH
    echo "[club-arena pre-push] running the Python guards on $("$CA_PY" -V 2>&1), the 3.11-or-newer CI uses (this PATH had $CA_PY_WAS)."
  fi
  # BASH (2026-11-06). macOS ships bash 3.2; CI and engine-01 run bash 5.
  # This runs before the Node step below, so Node 22 still ends up first.
  # The release shell tests spawn `bash` from PATH, so on this Mac they ran
  # the host transaction under 3.2, where an empty array under `set -u` is an
  # unbound-variable error, and refused a change production would have run
  # fine (#9630). When a bash 4 or newer is installed, the checks below get it
  # first on PATH through a private directory that holds only that one link,
  # so no other tool's resolution moves.
  for CA_BASH in ${CA_BASH_CANDIDATES:-/opt/homebrew/bin/bash /usr/local/bin/bash}; do
    [ -x "$CA_BASH" ] || continue
    if [ "$("$CA_BASH" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null || echo 0)" -ge 4 ]; then
      # The one-link shim must use the same external scratch as the tests.
      # Refuse an unavailable/internal directory rather than falling back to /tmp.
      CA_TMP_DEVICE=$(df -P "${TMPDIR:-/nonexistent}" 2>/dev/null | awk 'END {print $1}')
      CA_ROOT_DEVICE=$(df -P / 2>/dev/null | awk 'END {print $1}')
      CA_TMP_MOUNT=$(ca_mount_of "${TMPDIR:-/nonexistent}")
      case "$CA_TMP_MOUNT" in /Volumes/*) ;; *) CA_TMP_DEVICE="" ;; esac
      if [ ! -d "${TMPDIR:-}" ] || [ ! -w "$TMPDIR" ] || [ -z "$CA_TMP_DEVICE" ] || [ -z "$CA_ROOT_DEVICE" ] || [ "$CA_TMP_DEVICE" = "$CA_ROOT_DEVICE" ]; then
        echo "[club-arena pre-push] external scratch unavailable for Bash checks." >&2
        exit 1
      fi
      CA_BASH_DIR=$(mktemp -d "$TMPDIR/club-arena-pre-push-bash.XXXXXX") || exit 1
      if ! ln -s "$CA_BASH" "$CA_BASH_DIR/bash"; then rmdir "$CA_BASH_DIR"; exit 1; fi
      PATH="$CA_BASH_DIR:$PATH"
      export PATH
      echo "[club-arena pre-push] running the shell checks on $("$CA_BASH" -c 'echo bash $BASH_VERSION'), the major CI uses."
      break
    fi
  done
  CA_NODE_MAJOR=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
  if [ "$CA_NODE_MAJOR" != 22 ]; then
    # The newest nvm 22.x, compared by version number, not by path text.
    CA_NODE22=""
    CA_NODE22_RANK=-1
    for d in "$HOME"/.nvm/versions/node/v22.*/bin; do
      [ -x "$d/node" ] || continue
      v=$(basename "$(dirname "$d")")
      IFS=. read -r _ v_minor v_patch <<EOV
${v#v}
EOV
      rank=$(( ${v_minor:-0} * 100000 + ${v_patch:-0} ))
      if [ "$rank" -gt "$CA_NODE22_RANK" ]; then CA_NODE22_RANK=$rank; CA_NODE22=$d; fi
    done
    for d in $CA_NODE22 /opt/homebrew/opt/node@22/bin; do
      if [ -x "$d/node" ]; then
        PATH="$d:$PATH"
        export PATH
        echo "[club-arena pre-push] running the checks on Node $("$d/node" -v), the runtime CI uses (this shell had Node $CA_NODE_MAJOR)."
        break
      fi
    done
  fi

fi

# September 17: applicable prechecks must run before submission. Probe this
# owned checkout read-only; never install into a shared symlink from a hook.
# Missing dependencies refuse the affected check instead of deferring it to CI.
CA_TREE_TOP="$(git rev-parse --show-toplevel)"
# Direct policy verification and one actual-result receipt in this worktree's
# private Git metadata. A failed check keeps its original failing exit status.
POLICY_PRECHECK_STARTED=$(date +%s)
# A killed attempt must never leave a prior passed receipt as its apparent result.
POLICY_PRECHECK_RECEIPT=$(git rev-parse --git-path agent-policy-preflight.json)
rm -f -- "$POLICY_PRECHECK_RECEIPT"
policy_precheck_result() {
  policy_exit=$?
  trap - EXIT
  if [ -n "${CA_PUSH_TMP:-}" ] && [ ! -d "$CA_PUSH_TMP" ]; then
    echo "[club-arena pre-push] BLOCKED: this run's scratch $CA_PUSH_TMP vanished during the run (the drive dropped or was remounted). Failures above are environmental; push again once the drive is back." >&2
    policy_exit=1
    CA_BASH_DIR=""
    CA_PY_DIR=""
  fi
  if [ -n "${CA_BASH_DIR:-}" ]; then
    rm -f -- "$CA_BASH_DIR/bash"
    rmdir -- "$CA_BASH_DIR" || policy_exit=1
  fi
  if [ -n "${CA_PY_DIR:-}" ]; then
    rm -f -- "$CA_PY_DIR/python3"
    rmdir -- "$CA_PY_DIR" || policy_exit=1
  fi
  node "$CA_TREE_TOP/docs/agent-policy/agent-policy.mjs" hook-report "$POLICY_PRECHECK_STARTED" "$policy_exit" || policy_exit=1
  exit "$policy_exit"
}
trap policy_precheck_result EXIT
# Explicit signal exits prevent interrupted children from producing a pass.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
node "$CA_TREE_TOP/docs/agent-policy/agent-policy.mjs" check
node --test "$CA_TREE_TOP/docs/agent-policy/agent-policy.test.mjs"
node --test "$CA_TREE_TOP/tests/explicit-table-access.test.mjs"
node "$CA_TREE_TOP/scripts/ci/check-explicit-table-access.mjs"

# Source pins are cheap prerequisites. Reject inconsistent current inputs
# before installing/running their expensive qualification suites.
python3 "$CA_TREE_TOP/scripts/ci/verify-source-bindings.py"

CLIENT_DEPENDENCY_MODE=$(node "$CA_TREE_TOP/scripts/local-dependency-policy.mjs" "$CA_TREE_TOP")
SERVER_DEPENDENCY_MODE=local
if [ -f "$CA_TREE_TOP/server/package.json" ]; then
  SERVER_DEPENDENCY_MODE=$(node "$CA_TREE_TOP/scripts/local-dependency-policy.mjs" "$CA_TREE_TOP/server")
fi

ALL_FILES=""
PUSH_MAIN_TIP=""
# Get the range of commits being pushed
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # Skip deletions
  if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # Tests read this checkout: a different ref or dirty tracked files cannot
  # qualify the bytes being submitted. Commit intended fixes before pushing.
  if [ "$LOCAL_SHA" != "$(git rev-parse HEAD)" ] || ! git diff --quiet HEAD --; then
    echo "[club-arena pre-push] BLOCKED: prechecks require the pushed HEAD and clean tracked files."
    exit 1
  fi

  case "$REMOTE_REF" in
    refs/heads/*)
      bash "$(git rev-parse --show-toplevel)/scripts/guard-merged-branch.sh" \
        "${REMOTE_REF#refs/heads/}" "$REMOTE" "$URL"
      ;;
  esac

  # Git passes a literal URL as $1 for URL pushes, not a remote name.
  # Capture the associated tracking main once. Unknown/ambiguous destinations
  # refuse explicitly instead of silently falling back to stale local main.
  if [ -z "$PUSH_MAIN_TIP" ]; then
    PUSH_MAIN_TIP=$(node "$CA_TREE_TOP/scripts/ci/resolve-push-main.mjs" "$REMOTE" "$URL") || exit 1
  fi

  if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
    # ─────────────────────────────────────────────────────────────────────
    # NEW BRANCH — AND THIS LINE USED TO CHECK NOTHING AT ALL (2026-09-06).
    #
    # It read `git diff --name-only "$LOCAL_SHA"`, which compares the WORKING
    # TREE against that commit. At push time the tree is clean, so it returned
    # an EMPTY list — the exact opposite of the comment above it. Empty FILES
    # means empty CHANGED_SRC and CHANGED_TESTS, which means the whole vitest
    # gate below is skipped in silence. Every house rule still ran and printed
    # OK, so the push looked thoroughly checked; the one guard CLAUDE.md rule 8
    # calls the seatbelt against a red test had simply not run.
    #
    # Measured on this branch: 0 files that way, 7 the right way. The push went
    # green with a test that CI then failed on — the test file was even in the
    # diff, and `vitest related` finds it in four seconds.
    #
    # WORSE, IT IS THE PATH EVERY AGENT NOW TAKES. Section 10.82 (binding, the
    # same day) requires a NEW BRANCH off main for every follow-up commit, so
    # the rule written to stop commits vanishing routes all of them through the
    # one case where the test gate is blind. On a dirty tree it was not merely
    # empty either — it listed exactly the files you had NOT committed.
    #
    # This is 10.86's rule 1 and 2 in one line: an unreadable answer coerced
    # into an empty one, and "I could not tell" reported as "nothing changed".
    # It gets the same ladder the remote-tip branch below already has: diff
    # against the merge base, and if there is no base, check the whole tree.
    # Never nothing.
    # ─────────────────────────────────────────────────────────────────────
    BASE=$(git merge-base "$LOCAL_SHA" "$PUSH_MAIN_TIP" 2>/dev/null || true)
    if [ -n "$BASE" ]; then
      RANGE="$BASE..$LOCAL_SHA"
      FILES=$(git diff --name-only "$BASE" "$LOCAL_SHA" 2>/dev/null || true)
    else
      echo "[club-arena pre-push] NOTE: new branch with no common base with"
      echo "                      main. Checking the whole tree rather than"
      echo "                      nothing."
      RANGE="$LOCAL_SHA"
      FILES=$(git ls-files 2>/dev/null || true)
    fi
  else
    # ─────────────────────────────────────────────────────────────────────
    # THE REMOTE TIP MAY NOT BE IN THIS CLONE, AND THAT IS NORMAL HERE.
    #
    # Agents work in worktrees from scripts/agent-workspace.sh and sync with
    # `git fetch origin main`, which does NOT fetch other branches. Autopilot
    # meanwhile pushes merge commits onto agent branches to keep them fresh,
    # so the remote tip of YOUR OWN branch is routinely a commit you have
    # never seen.
    #
    # Until 2026-08-23 the next line ran `git diff` against it with `set -e`
    # still in force, so the hook died on its first instruction with a bare
    #
    #     fatal: bad object 73ea7423e942f8c91ed417fd8f23124f5eefd307
    #     husky - pre-push script failed (code 128)
    #
    # before a single house rule or test had run. The message names nothing,
    # suggests nothing, and points at no file. It cost a real debugging cycle
    # to trace to this line.
    #
    # The danger is not the wasted time. An inscrutable pre-push failure makes
    # the actual repair unclear, so this guard names the missing authority.
    #
    # So: fetch it, and if it still is not here, check against main instead.
    # Never die, and never silently check nothing.
    # ─────────────────────────────────────────────────────────────────────
    if ! git cat-file -e "${REMOTE_SHA}^{commit}" 2>/dev/null; then
      git fetch -q "$REMOTE" "$REMOTE_SHA" 2>/dev/null || true
    fi
    if git cat-file -e "${REMOTE_SHA}^{commit}" 2>/dev/null; then
      RANGE="$REMOTE_SHA..$LOCAL_SHA"
      FILES=$(git diff --name-only "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null || true)
    else
      BASE=$(git merge-base "$LOCAL_SHA" "$PUSH_MAIN_TIP" 2>/dev/null || true)
      if [ -n "$BASE" ]; then
        echo "[club-arena pre-push] NOTE: the remote tip of this branch"
        echo "                      ($REMOTE_SHA)"
        echo "                      is not in this clone, so there is nothing to diff it"
        echo "                      against. Checking everything since main instead —"
        echo "                      a WIDER check, never a skipped one."
        echo "                      (A plain \`git fetch $REMOTE\` brings it in.)"
        RANGE="$BASE..$LOCAL_SHA"
        FILES=$(git diff --name-only "$BASE" "$LOCAL_SHA" 2>/dev/null || true)
      else
        echo "[club-arena pre-push] NOTE: no common base with main could be found."
        echo "                      Checking the whole tree rather than nothing."
        RANGE="$LOCAL_SHA"
        FILES=$(git ls-files 2>/dev/null || true)
      fi
    fi
  fi

  # ═══════════════════════════════════════════════════════════════════════
  # A FILE THAT IS IDENTICAL TO origin/main CANNOT BE A NEW VIOLATION.
  #
  # Every FILES= above diffs against the branch's PREVIOUS REMOTE TIP. That is
  # the right question for "what am I pushing", and the wrong one for "what did
  # I write": the moment you `git merge origin/main` - which section 12 says to
  # do, because rebasing main is refused - every file main changed since that
  # tip appears in the list as though you had touched it.
  #
  # 2026-09-06, measured: a push carrying three one-file fixes was BLOCKED by
  # check 4 on src/services/HandNotesService.ts, a file the branch never
  # opened. It was byte-identical to origin/main, where it had landed in #3289
  # and passed the full required suite. The gate was reporting main's own
  # shipped code as this branch's violation.
  #
  # That matters more than the lost minutes. Check 4's own comment promises
  # "this gate only fires on files you actually touch, so they are a to-do,
  # not a wall" - and autopilot merges main into every open branch on a timer,
  # so the wall builds itself. The list is narrowed to the branch-owned diff;
  # mandatory checks remain active for every push.
  #
  # Compare with the protected main ancestor actually inherited by this head.
  # Another task can advance the shared origin/main while this push runs. Its
  # newer engine bytes must not turn our unchanged inherited engine into a
  # branch-owned change. Capture the base once; no known base keeps every input.
  # ═══════════════════════════════════════════════════════════════════════
  if [ -n "$FILES" ]; then
    QUALIFIED_MAIN_BASE=$(git merge-base "$LOCAL_SHA" "$PUSH_MAIN_TIP" 2>/dev/null || true)
    KEPT=""
    DROPPED=0
    for f in $FILES; do
      if [ -n "$QUALIFIED_MAIN_BASE" ] && git diff --quiet "$QUALIFIED_MAIN_BASE" "$LOCAL_SHA" -- "$f" 2>/dev/null; then
        DROPPED=$((DROPPED + 1))
        continue
      fi
      KEPT="$KEPT$f
"
    done
    FILES="$KEPT"
    if [ "$DROPPED" -gt 0 ]; then
      echo "[club-arena pre-push] $DROPPED file(s) came in with a main merge and are"
      echo "                      byte-identical to inherited main $QUALIFIED_MAIN_BASE; judging the rest."
    fi
  fi

  ALL_FILES="$ALL_FILES
$FILES"

  # ═══════════════════════════════════════════════════════════════════════
  # 5. NON-FAST-FORWARD PUSH TO main — added 2026-08-21 after a real loss.
  #
  # WHAT HAPPENED: main was rewound to ada755ab3 and four commits that were
  # already built, synced and SERVING IN PRODUCTION were dropped from it:
  # 5d42741e4 (seat-as-reservation), d884f5fd2 (BBJ palette re-land),
  # ea6d53082 (throwables sizing) and e0f707a09 (the case-sensitivity CI
  # fix). Production was left running code that main no longer contained,
  # so the next sync would have quietly deleted four features. The round-8
  # changelog on main still described that work as shipped, which is how you
  # know it was an accident and not a revert — nobody writes a changelog for
  # work they meant to drop.
  #
  # WHY A HOOK AS WELL AS BRANCH PROTECTION: when this was written (2026-08-21)
  # the repo was private without GitHub Pro and nothing server-side refused a
  # force-push. CORRECTED 2026-09-03: ruleset `main protection` (21163380) is
  # ACTIVE with `non_fast_forward` and `deletion` rules, so GitHub now refuses
  # a rewind too. This check stays because it fails in 100ms on the machine
  # doing it, with the list of commits that would vanish, instead of a bare
  # "protected branch hook declined" from the server.
  #
  # This is deliberately not a lint. Every other check in this file is about
  # the CONTENT of a push; this one is about whether the push DESTROYS
  # published history. Losing commits is the only failure here that cannot
  # be fixed forward by another commit.
  case "$REMOTE_REF" in
    refs/heads/main)
      if [ "$REMOTE_SHA" != "0000000000000000000000000000000000000000" ]; then
        # The remote tip must be reachable from what we are about to push.
        # If it is not, this push deletes commits that are already on main.
        if ! git cat-file -e "$REMOTE_SHA" 2>/dev/null; then
          git fetch -q "$REMOTE" "$REMOTE_SHA" 2>/dev/null || true
        fi
        if ! git cat-file -e "$REMOTE_SHA" 2>/dev/null; then
          echo "[club-arena pre-push] BLOCKED: cannot verify this push is fast-forward."
          echo "                      The current remote tip ($REMOTE_SHA) is not in"
          echo "                      this clone, so whether it drops commits is unknowable."
          echo "                      Run: git fetch $REMOTE main   then push again."
          FAIL=1
        elif ! git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null; then
          DROPPED=$(git rev-list --count "$LOCAL_SHA..$REMOTE_SHA" 2>/dev/null || echo "?")
          echo ""
          echo "[club-arena pre-push] BLOCKED: this push REWINDS main."
          echo ""
          echo "  Remote main is at $REMOTE_SHA, which is NOT an ancestor of what you"
          echo "  are pushing. $DROPPED commit(s) currently on main would stop existing."
          echo ""
          echo "  Commits that would be dropped:"
          git log --oneline --max-count=15 "$LOCAL_SHA..$REMOTE_SHA" 2>/dev/null | sed 's/^/    /'
          echo ""
          echo "  This is how four production-serving commits were lost on 2026-08-21."
          echo "  Preserve the work on a feature branch and merge current main into it:"
          echo ""
          echo "      git fetch $REMOTE main"
          echo "      git switch <feature-branch>"
          echo "      git merge $REMOTE/main"
          echo "      git push $REMOTE <feature-branch>"
          echo ""
          echo "  If you are deliberately reverting, revert with a commit - that keeps"
          echo "  the history and is reviewable. A rewind leaves no trace of what went."
          echo ""
          echo "  There is no local bypass. GitHub rulesets also reject this operation."
          echo ""
          FAIL=1
        fi
      fi
      ;;
  esac

  # Migration presence uses Git and the tracked schema manifest, not credentials.
  # Check the whole branch: a follow-up push can otherwise hide an earlier
  # migration behind HEAD~1 or the previous remote feature-branch tip.
  MIGRATION_BASE=$(git merge-base "$LOCAL_SHA" "$PUSH_MAIN_TIP" 2>/dev/null || true)
  if [ -z "$MIGRATION_BASE" ]; then
    echo "[club-arena pre-push] BLOCKED: cannot establish the migration branch base."
    FAIL=1
  elif ! node scripts/ci/check-migrations-applied.mjs "$MIGRATION_BASE"; then
    echo "[club-arena pre-push] BLOCKED by check-migrations-applied (CI runs this too)"
    FAIL=1
  fi

  # 0. Repo-wide invariants. Both are ~100ms.
  #
  #    CORRECTED 2026-08-28. This comment used to say branch protection was
  #    unavailable without GitHub Pro and that "nothing enforces it server-side
  #    any more". Checked against the API: ruleset `main protection` (21163380)
  #    is ACTIVE on main with `bypass_actors: []` and six required checks. It
  #    enforces. These two guards run here because catching them in 100ms beats
  #    catching them in a three-minute CI cycle, not because nothing else will.
  if [ -f scripts/ci/check-allin-pointer-events.mjs ]; then
    if ! node scripts/ci/check-allin-pointer-events.mjs; then
      echo "[club-arena pre-push] BLOCKED: all-in action panel would lose pointer events"
      FAIL=1
    fi
  fi
  if [ -f scripts/ci/check-monitoring-drift.mjs ]; then
    if ! node scripts/ci/check-monitoring-drift.mjs; then
      echo "[club-arena pre-push] BLOCKED: monitoring wiring is broken"
      FAIL=1
    fi
  fi
  # A commit carrying [skip ci] starts NO workflow run, so the bundle is never
  # built and production keeps serving the previous one with nothing red
  # anywhere. Every other net in the estate RECOVERS from that; this one
  # prevents it. Real precedent: 454fa1da4.
  if [ -f scripts/ci/check-no-skip-markers.mjs ]; then
    if ! node scripts/ci/check-no-skip-markers.mjs; then
      echo "[club-arena pre-push] BLOCKED: a commit would suppress its own publish"
      FAIL=1
    fi
  fi
  # A SECURITY DEFINER function that writes and that a browser can call must
  # consult the request. Nineteen did not on 2026-08-27; one let any member
  # rewrite a club's member_count, another pays chips. Scoped to the migrations
  # this branch adds, because supabase/migrations/ is intentionally stale.
  # An insert that omits a NOT NULL column with no default cannot land, and the
  # error lands in a catch. Whole-tree and currently at zero, so any new one is
  # this push's doing.
  if [ -f scripts/ci/check-required-columns.mjs ]; then
    if ! node scripts/ci/check-required-columns.mjs; then
      echo "[club-arena pre-push] BLOCKED: an insert omits a column its table requires."
      FAIL=1
    fi
  fi
  if [ -f scripts/ci/check-definer-authorization.mjs ]; then
    DEF_BASE=$(git merge-base HEAD origin/main 2>/dev/null || echo "HEAD~1")
    if ! node scripts/ci/check-definer-authorization.mjs "$DEF_BASE"; then
      echo "[club-arena pre-push] BLOCKED: a SECURITY DEFINER writer a browser can reach"
      echo "                      never asks who is calling. See the remedy above."
      FAIL=1
    fi
  fi
  # An UPDATE or DELETE with no WHERE runs fine from a migration (as postgres)
  # and is REFUSED on the PostgREST path, because `authenticator` preloads
  # safeupdate. It therefore passes every check the author runs and breaks in
  # production. 2026-09-06: one of these silently stopped the GTO aggregation
  # driver, and the sweep after it found nine more already live.
  if [ -f scripts/ci/check-unqualified-writes.mjs ]; then
    UQW_BASE=$(git merge-base HEAD origin/main 2>/dev/null || echo "HEAD~1")
    if ! node scripts/ci/check-unqualified-writes.mjs "$UQW_BASE"; then
      echo "[club-arena pre-push] BLOCKED: an UPDATE or DELETE with no WHERE clause."
      echo "                      PostgREST refuses it; a migration does not. See above."
      FAIL=1
    fi
  fi

  # A trigger on a money table declares itself in the migration that creates
  # it. UndeclaredTriggerOnAMoneyTable is critical and pages by SMS; it read 76
  # on 2026-09-12 having read 74 ninety minutes before, so it is saturated and
  # one more makes no visible difference. Enforced where the trigger is written.
  if [ -f scripts/ci/check-money-trigger-declared.mjs ]; then
    MTD_BASE=$(git merge-base HEAD origin/main 2>/dev/null || echo "HEAD~1")
    if ! MONEY_TRIGGER_BASE="$MTD_BASE" node scripts/ci/check-money-trigger-with-recovery.mjs "$MTD_BASE"; then
      echo "[club-arena pre-push] BLOCKED: an undeclared trigger on a money table."
      echo "                      Declare it in the same migration. See above."
      FAIL=1
    fi
  fi

  # NO BAND-AIDS (10.12). A repair, back-pay, re-drive, catch-up, backfill or
  # heal path is not a fix; it is the defect happening for ever with paperwork.
  if [ -f scripts/ci/check-no-new-band-aids.mjs ]; then
    BA_BASE=$(git merge-base HEAD origin/main 2>/dev/null || echo "HEAD~1")
    if ! node scripts/ci/check-no-new-band-aids.mjs "$BA_BASE"; then
      echo "[club-arena pre-push] BLOCKED: this migration ships a band-aid (10.12)."
      echo "                      Fix the line that produced it. See above."
      FAIL=1
    fi
  fi

  # 0b. TYPE CHECK — added 2026-08-27, re-justified 2026-08-28.
  #
  #    THIS IS FAST FEEDBACK, NOT ENFORCEMENT. Be clear about that, because the
  #    commit that added it was not: it claimed a direct push to main went
  #    unchecked and that this hook was the only gate left. Both were wrong.
  #    The `main protection` ruleset requires a pull request and six green
  #    checks, `TypeScript Check` among them, and nobody bypasses it — so a
  #    type error has never been able to reach main.
  #
  #    What it buys is the three minutes between pushing a branch and CI
  #    telling you what tsc would have told you in four seconds. That is worth
  #    a hook; pretending it is the last line of defence is not.
  #
  #    COST: about 40s cold, about 4s warm — tsconfig.json already sets
  #    `incremental` with a tsBuildInfoFile, so only the first run pays. Runs
  #    at all only when the push touches src/**.ts(x).
  #
  #    Missing dependencies or compiler refuse this applicable local gate.
  #    Hosted checks remain required after these faster local checks pass.
  if echo "$FILES" | grep -qE '^(src/.*\.tsx?|tsconfig[^/]*\.json|package(-lock)?\.json)$'; then
    TSC="$(git rev-parse --show-toplevel)/node_modules/.bin/tsc"
    if [ "$CLIENT_DEPENDENCY_MODE" != local ]; then
      echo "[club-arena pre-push] BLOCKED: required local compiler dependencies are incomplete."
      echo "  remedy: (cd \"$CA_TREE_TOP\" && npm ci --ignore-scripts --no-audit --no-fund)"
      FAIL=1
    elif [ -x "$TSC" ]; then
      echo "[club-arena pre-push] type-checking src/ ..."
      if ! "$TSC" --noEmit; then
        echo ""
        echo "[club-arena pre-push] BLOCKED: src/ does not type-check."
        echo "                      Fix the errors above. CI's TypeScript Check"
        echo "                      is a required check and would refuse this"
        echo "                      pull request anyway - this just tells you"
        echo "                      now instead of in three minutes."
        FAIL=1
      fi
    else
      echo "[club-arena pre-push] BLOCKED: the required local compiler is unavailable."
      FAIL=1
    fi
  fi

  # 1. Merge conflict markers
  #
  # The separator git writes is EXACTLY seven equals signs on its own line, so
  # that is what this matches. It used to accept seven OR MORE, which also
  # matched an ASCII rule inside a fenced code block: the verbatim probe output
  # in docs/changelog/2026-09-05-the-cluster-boards-are-a-rolled-back-probe-harness.md
  # underlines its sections with 64 of them, so after that file landed on main
  # every branch that merged main was refused a push for a conflict it did not
  # have. Exactly seven still catches every real marker.
  for f in $FILES; do
    if [ -f "$f" ]; then
      if grep -nE '^(<<<<<<< |>>>>>>> |={7}$)' "$f" >/dev/null 2>&1; then
        echo "[club-arena pre-push] BLOCKED: $f contains a merge-conflict marker"
        FAIL=1
      fi
    fi
  done

  # 2. vercel.json crons (policy: Open Claw exclusive)
  for f in $FILES; do
    case "$f" in
      *vercel.json)
        if [ -f "$f" ] && grep -q '"crons"' "$f"; then
          echo "[club-arena pre-push] BLOCKED: $f introduces a Vercel crons block"
          echo "                      Use Open Claw → workers exclusively."
          FAIL=1
        fi
        ;;
    esac
  done

  # 3. Client-side PIN-gate storage (Phase 3.6 forbids reintroducing this)
  for f in $FILES; do
    if [ -f "$f" ]; then
      case "$f" in
        *src/lib/auth/*) continue ;;
      esac
      if grep -qE "localStorage\.(set|get)Item\(['\"](commanderAdminPin|admin_pin|club_admin_pin)" "$f" 2>/dev/null; then
        echo "[club-arena pre-push] BLOCKED: $f reintroduces client-side PIN storage"
        echo "                      Phase 3.6 moved PIN validation server-side."
        FAIL=1
      fi
    fi
  done

  # 4. Raw supabase.auth.getUser() outside the canonical auth module
  #
  # 2026-08-21: this rule was unenforceable as written. It told you to "use
  # validateBearer() from src/lib/auth", but `src/lib/auth/` has never existed
  # in this repo's history and `validateBearer` has never been defined
  # anywhere. Phase 6 Rule 4 named a migration target that was never built, so
  # the gate itself had to be corrected before it could enforce the real rule.
  #
  # The canonical module is src/lib/authUtils.ts, and the helper is
  # readLocalSession(): it parses the shared 'smarter-poker-auth' JWT, honours
  # expiry, and is already documented in-file as "the SINGLE canonical
  # implementation - all auth code should use this". The rule now names it.
  #
  # src/lib/supabase.ts is exempt on purpose: it is the SDK wrapper, and
  # somebody has to be allowed to call the SDK.
  #
  # Known remaining callers, not yet migrated (this gate only fires on files
  # you actually touch, so they are a to-do, not a wall):
  #   src/services/WalletService.ts        src/services/AvatarService.ts
  #   src/services/AgentService.ts         src/components/table/RealTimeResultPanel.tsx
  #   src/components/tournament/TournamentStartingTicker.tsx
  #   src/components/tournament/TournamentRankingCard.tsx
  for f in $FILES; do
    if [ -f "$f" ]; then
      case "$f" in
        *src/lib/authUtils*) continue ;;
        *src/lib/supabase.ts) continue ;;
          *node_modules/*) continue ;;
        *.husky/*) continue ;;
        # 2026-08-21: this gate is about CODE calling the raw auth API. It was
        # matching prose too, so MIGRATION-CHANGELOG.md — which QUOTES the
        # pattern in an audit entry from 2026 — blocked every push that
        # touched the changelog. Docs and data cannot call anything.
        *.md|*.markdown|*.txt|*.json|*.sql|*.lock) continue ;;
      esac
      # 2026-09-04: match CODE, not prose. This grep blocked a push whose
      # only hit was a docblock QUOTING the pattern to explain why one module
      # legitimately asks GoTrue (src/lib/sessionRevoked.ts). Strip // and
      # /* */ comments before looking; a comment cannot call anything.
      if sed -E 's://.*$::' "$f" 2>/dev/null | perl -0pe 's{/\*.*?\*/}{}gs' | grep -qE 'supabase\.auth\.getUser\(\)'; then
        echo "[club-arena pre-push] BLOCKED: $f calls supabase.auth.getUser()"
        echo "                      use readLocalSession() from src/lib/authUtils instead."
        FAIL=1
      fi
    fi
  done
done
FILES=$(printf '%s\n' "$ALL_FILES" | sort -u)

# ─────────────────────────────────────────────────────────────────────────────
# HOUSE TEXT RULES (Dan 2026-08-21)
#
#   "First letter of every word is capitalized, that's a hard rule for all
#    forward facing pages", and em dashes are forbidden.
#
# Both had a checker already, but it only ran in ci.yml - the workflow this
# repo's own notes say NEVER COMPLETES on main, because pushes land faster than
# its ~6 minutes and cancel-in-progress kills every run. A gate that never
# finishes is not a gate, so they run here, where the other house rules live.
# Together they take about two seconds.
#
# Autofix:  node scripts/ci/check-title-case.mjs --fix
#           node scripts/ci/check-ui-text.mjs --fix
# ─────────────────────────────────────────────────────────────────────────────
# The copy guards parse TypeScript. Missing tooling refuses an applicable
# source/configuration check before CI; prose-only changes use their own pins.
copy_case_guard() {
  guard="$1"
  [ -f "$guard" ] || return 0
  if ! echo "$FILES" | grep -qE '^(src/|package(-lock)?\.json$|scripts/ci/check-(title-case|painted-text-case|nav-title-case)\.mjs$|\.husky/)'; then
    return 0
  fi
  if ! node -e 'require("typescript")' >/dev/null 2>&1; then
    echo "[club-arena pre-push] BLOCKED: local TypeScript unavailable for $(basename "$guard")."
    FAIL=1
    return 0
  fi
  if ! node "$guard"; then
    FAIL=1
  fi
}

copy_case_guard scripts/ci/check-title-case.mjs

# The third surface of the same rule: text painted from a string ATTRIBUTE or
# from a string literal inside a JSX EXPRESSION. Autofix:
#   node scripts/ci/check-painted-text-case.mjs --fix
copy_case_guard scripts/ci/check-painted-text-case.mjs

# The other half of the same rule. check-title-case.mjs inspects JsxText only
# and states in its own header that expression values "are cased at their
# source" - a promise nothing enforced. Every navigation surface renders its
# copy from a config registry through {item.label}, so 55 menu strings sat
# uncased for months in the gap between the two. Autofix:
#   node scripts/ci/check-nav-title-case.mjs --fix
copy_case_guard scripts/ci/check-nav-title-case.mjs

# Protected work must not be orphaned from main.
# Two of the 2026-08-21 throwables regressions were stale bundles (now covered
# by the World Hub provenance gate). The third was a commit that stopped being
# an ancestor of main because history was rewritten over it, and it passed
# every content-level guard: the source file, its imports and its registry
# entry vanished together, so the resulting main was self-consistent.
# The non-fast-forward check above stops the obvious force-push; this catches
# the work going missing by any route, including a merge resolved stale-side.
if [ -f scripts/ci/check-no-orphaned-work.mjs ]; then
  if ! node scripts/ci/check-no-orphaned-work.mjs; then
    echo "[club-arena pre-push] BLOCKED: protected work has been orphaned from main"
    FAIL=1
  fi
fi

# check-ui-text.mjs also starts scripts/ci/check-ui-dollar.mjs, the other half
# of the copy rule (Dan 2026-10-09: "you are forbidden from using $ the dollar
# sign anywhere in the club arena"), so a rendered "$" fails here too. Law:
# tests/the-club-arena-shows-no-dollar-sign.law.test.ts.
if [ -f scripts/ci/check-ui-text.mjs ]; then
  if ! node scripts/ci/check-ui-text.mjs; then
    FAIL=1
  fi
fi

# DOCTRINE FRESHNESS (added 2026-09-04). CLAUDE.md 10.8.1 already says laws are
# read from origin/main and never from your local tree; nothing checked.
# Measured on this machine that day, AFTER pruning 51 worktrees: 160 Club Arena
# worktrees, 154 whose CLAUDE.md differs from origin/main, and 102 still
# carrying `bash scripts/sync-club-arena.sh` or the heading "The Only Deploy
# Path" - a command deleted on 2026-09-02 whose directory Next serves BEFORE
# the rewrite, so following it SHADOWS the live bundle rather than duplicating
# it. Those trees are days old, not months; doctrine simply moved faster than
# they did, and pruning cannot fix that.
#
# It WARNS on an ordinary push and BLOCKS only when the diff touches doctrine
# itself (CLAUDE.md, LAWS.md, a *.law.test.*, a workflow, .agent/**, .husky/**,
# docs/HANDOFF*). That is the exact motion of the hamburger revert war - an
# agent enforcing a rule its own stale copy still carried. Blocking every push
# from a stale tree would instead stall a hundred branches behind a merge that
# can conflict, which section 12 exists because of.
#
# The script fails OPEN on any internal error. A freshness advisor that can
# wedge every push in the estate is a worse bug than the staleness it detects.
if [ -f scripts/ci/check-doctrine-freshness.mjs ]; then
  if ! node scripts/ci/check-doctrine-freshness.mjs; then
    echo "[club-arena pre-push] BLOCKED: doctrine changed from a stale worktree"
    FAIL=1
  fi
fi

# ═════════════════════════════════════════════════════════════════════════════
# 10. THE TEST SUITE — THE ONE GATE THAT WAS MISSING (Dan, 2026-08-21)
#
# On 2026-08-21 main sat unable to deploy FOUR separate times, every one of
# them a red test pushed alongside the feature it was meant to guard:
#
#   - tests/tip-dealer-guards.test.tsx imported a component deleted the day
#     before, so it failed at transform time from the moment it landed.
#   - tests/unit/handCompletionLaw.test.ts read src/services/soundService.ts.
#     The file is SoundService.ts. macOS resolved it; Linux CI did not.
#   - tests/unit/winningCardHighlight.test.ts asserted that the engine sends
#     card_indices. The engine has never contained that string. It was a
#     specification committed with no implementation beside it - by a commit
#     whose own message was "unblock the deploy gate".
#   - tests/actionpanel-raise-presets.test.ts still asserted the rounding rule
#     that the same commit's feature had just replaced.
#
# Each one blocked EVERY agent and every deploy until a human noticed, because
# `npx vitest run tests/` in publish-club-arena.yml is what publishes the
# bundle. This hook already enforces nine house rules about the CONTENT of a
# push and never once ran the tests.
#
# WHY TARGETED AND NOT THE WHOLE SUITE: the full run is minutes; `vitest
# related` on the files you actually touched is about four seconds, and it
# would have caught all four incidents above - three of them changed a test
# file (run directly), the fourth changed ActionPanel.tsx (found by related).
# The targeted gate is mandatory. Missing dependencies are a refusal, not an
# environment-variable escape hatch.
# ═════════════════════════════════════════════════════════════════════════════
# 2026-08-23: gated on a LOCAL vitest. This hook ran in NONE of the 38 agent
# worktrees whose core.hooksPath pointed at the gitignored .husky/_ (see
# scripts/ensure-hooks.sh). Restoring it there would have run the suite through
# the npx package fetcher in a tree with no node_modules - a network round trip
# on every push. scripts/agent-workspace.sh links node_modules in, so this
# normally runs; when it truly cannot, it says so rather than letting a suite
# that never ran look like a suite that passed.
# Qualification manifests are executable contracts too. Validate the existing
# cash input set before an expensive hosted PostgreSQL job can reject stale pins.
CASH_INPUT_CHANGED=$(node --input-type=module -e '
  import { readFileSync } from "node:fs";
  const manifestPath = "scripts/qualification/cash-native-hosted.manifest.json";
  const pins = JSON.parse(readFileSync(manifestPath, "utf8")).files;
  console.log(process.argv.slice(1).some(f => f === manifestPath || Object.hasOwn(pins, f)) ? "yes" : "no");
' $FILES)
if [ "$CASH_INPUT_CHANGED" = yes ]; then
  if ! python3 -m unittest discover -s scripts/ci -p test_cash_native_pgcron.py; then
    echo "[club-arena pre-push] BLOCKED: cash qualification input checks failed."
    # An invalid input manifest cannot qualify this candidate. Stop before
    # the expensive suites so repairing its pins does not run them twice.
    exit 1
  fi
fi

# BEGIN TARGETED CLIENT PREFLIGHT
# Select executable contracts for every changed path, including documents,
# workflows, scripts and deleted files. Import tracing alone misses readFileSync.
# The read-only dependency probe above inspects THIS tree, not another clone.
VITEST="$CA_TREE_TOP/node_modules/.bin/vitest"
CHANGED_TESTS=""
CHANGED_SRC=""
NODE_TESTS=""
for f in $FILES; do
  if [ -f "$f" ]; then
    case "$f" in
      tests/*.test.ts|tests/*.test.tsx) CHANGED_TESTS="$CHANGED_TESTS $f" ;;
      tests/*.test.mjs)
        if grep -q 'node:test' "$f"; then NODE_TESTS="$NODE_TESTS $f"; fi ;;
      src/*.ts|src/*.tsx|server/src/*.ts)
        case "$f" in *.test.ts|*.test.tsx|*.d.ts) ;; *) CHANGED_SRC="$CHANGED_SRC $f" ;; esac ;;
    esac
  fi
done
# Evidence packs repeat names across hundreds of shard directories. A source
# contract depends on the basename, so search each distinct name exactly once.
# Keep deleted paths in this set: their consumers still need verification.
CONTRACT_BASENAMES=$(printf '%s\n' $FILES | sed 's#.*/##' | sort -u)
# Reviewed native closures override only filename collisions. Declaration drift
# retains the test; invalid/missing inventory stops this actual owning hook.
UNCHANGED_NATIVE_CONTRACTS=$(node "$CA_TREE_TOP/scripts/ci/source-contract-inventory.mjs" $FILES) || exit 1
UNCHANGED_NATIVE_CONTRACTS=$(printf '%s\n' "$UNCHANGED_NATIVE_CONTRACTS" | tr '\n' ' ')
# Directory-scanning workflow contracts do not name an individual YAML file.
if printf '%s\n' $FILES | grep -qE '^\.github/workflows/'; then
  CONTRACT_BASENAMES="$CONTRACT_BASENAMES .github/workflows"
fi
for base in $CONTRACT_BASENAMES; do
  for t in $(grep -rl --include='*.test.ts' --include='*.test.tsx' -F "$base" tests/ 2>/dev/null); do
    case " $UNCHANGED_NATIVE_CONTRACTS " in *" $t "*) continue ;; esac
    case " $CHANGED_TESTS " in *" $t "*) ;; *) CHANGED_TESTS="$CHANGED_TESTS $t" ;; esac
  done
  for t in $(grep -rl --include='*.test.mjs' -F "$base" tests/ 2>/dev/null); do
    case " $UNCHANGED_NATIVE_CONTRACTS " in *" $t "*) continue ;; esac
    if grep -q 'node:test' "$t"; then
      case " $NODE_TESTS " in *" $t "*) ;; *) NODE_TESTS="$NODE_TESTS $t" ;; esac
    fi
  done
done
# A changed test can also be found as a source contract; execute it once.
CHANGED_TESTS=$(printf '%s\n' $CHANGED_TESTS | sort -u)
NODE_TESTS=$(printf '%s\n' $NODE_TESTS | sort -u)
if [ -n "$CHANGED_TESTS$CHANGED_SRC$NODE_TESTS" ]; then
  if [ "$CLIENT_DEPENDENCY_MODE" != local ]; then
    echo "[club-arena pre-push] BLOCKED: required local client dependencies are incomplete."
    echo "  remedy: (cd \"$CA_TREE_TOP\" && npm ci --ignore-scripts --no-audit --no-fund)"
    echo "  Prepare locked dependencies in an owned workspace, run the checks and retry."
    echo "  Do not mutate shared dependencies or use hosted CI as the first test attempt."
    FAIL=1
  else
    if [ -n "$CHANGED_TESTS$CHANGED_SRC" ] && [ ! -x "$VITEST" ]; then
      echo "[club-arena pre-push] BLOCKED: the required local test runner is unavailable."
      FAIL=1
    else
      if [ -n "$CHANGED_TESTS" ]; then
        echo "[club-arena pre-push] running changed tests and contracts that read changed files..."
        if ! "$VITEST" run $CHANGED_TESTS; then
          echo "[club-arena pre-push] BLOCKED: an applicable local test failed. Repair the cause; never skip it."
          FAIL=1
        fi
      fi
      if [ -n "$CHANGED_SRC" ]; then
        echo "[club-arena pre-push] running tests importing the changed source..."
        # Source-contract tests above can also import changed source. They
        # already ran against these exact clean HEAD bytes; exclude only those
        # exact files from the related invocation, never a directory or family.
        RELATED_TEST_ARGS=()
        for tested_file in $CHANGED_TESTS; do
          RELATED_TEST_ARGS+=(--exclude "$tested_file")
        done
        # An empty remainder is valid only after a nonempty direct pass.
        if [ -n "$CHANGED_TESTS" ]; then RELATED_TEST_ARGS+=(--passWithNoTests); fi
        if ! "$VITEST" related --run $CHANGED_SRC "${RELATED_TEST_ARGS[@]}"; then
          echo "[club-arena pre-push] BLOCKED: a related local test failed."
          FAIL=1
        fi
      fi
    fi
    if [ -n "$NODE_TESTS" ]; then
      echo "[club-arena pre-push] running affected Node test contracts..."
      if ! node --test --test-concurrency=4 $NODE_TESTS; then
        echo "[club-arena pre-push] BLOCKED: an affected Node contract failed."
        FAIL=1
      fi
    fi
  fi
fi
# END TARGETED CLIENT PREFLIGHT

# Compile the engine inputs before submission, using its own package root.
if echo "$FILES" | grep -qE '^server/(src/.*\.ts|tsconfig[^/]*\.json|package(-lock)?\.json)$'; then
  SERVER_TSC="$CA_TREE_TOP/server/node_modules/.bin/tsc"
  if [ "$SERVER_DEPENDENCY_MODE" != local ] || [ ! -x "$SERVER_TSC" ]; then
    echo "[club-arena pre-push] BLOCKED: the required local server compiler is unavailable."
    echo "  remedy: (cd \"$CA_TREE_TOP/server\" && npm ci --ignore-scripts --no-audit --no-fund)"
    FAIL=1
  elif ! (cd server && "$SERVER_TSC" --noEmit); then
    echo "[club-arena pre-push] BLOCKED: the server does not type-check."
    FAIL=1
  fi
fi

# ── THE SERVER GATE (2026-08-25) ──
#
# server/ is its OWN vitest project: server/vitest.config.ts includes
# 'src/**/*.test.ts' and 'src/testing/horseRegression/**/*.test.mjs', while
# the root config includes only 'tests/**'. So the gate above — which runs
# the ROOT vitest — can never execute a single one of
# the 137 server test files, whatever it is handed. A changed
# server/src/x.test.ts matched no branch at all, and a changed server/src/x.ts
# was passed to `vitest related` in a project that does not know those tests
# exist.
#
# The engine is the highest-stakes code in this repository and it was the one
# part with NO pre-push test gate. The first version of this change provisioned
# server/node_modules and wrote a comment saying the hole was closed, which
# bought exactly nothing, because nothing here ever invoked server's vitest.
# Provisioning is necessary and it is not sufficient; this is the part that
# enforces.
SERVER_VITEST="$CA_TREE_TOP/server/node_modules/.bin/vitest"
if [ -f server/package.json ]; then
  SRV_TESTS=""
  SRV_SRC=""
  for f in $FILES; do
    [ -f "$f" ] || continue
    case "$f" in
      server/src/*.test.ts|server/src/**/*.test.ts|server/src/*.test.mjs|server/src/**/*.test.mjs)
        SRV_TESTS="$SRV_TESTS ${f#server/}" ;;
      server/src/*.ts|server/src/**/*.ts|server/src/*.mjs|server/src/**/*.mjs)
        case "$f" in
          *.d.ts) ;;
          *) SRV_SRC="$SRV_SRC ${f#server/}" ;;
        esac ;;
    esac
  done

  # Workflow readers live in the server Vitest project too. A CI-only edit
  # must exercise their literal contracts before hosted qualification starts.
  SERVER_WORKFLOW_BASENAMES=$(printf '%s\n' $FILES | sed -n '/^\.github\/workflows\//s#.*/##p' | sort -u)
  if [ -n "$SERVER_WORKFLOW_BASENAMES" ]; then
    SERVER_WORKFLOW_BASENAMES="$SERVER_WORKFLOW_BASENAMES .github/workflows"
  fi
  for base in $SERVER_WORKFLOW_BASENAMES; do
    for t in $(grep -rl --include='*.test.ts' --include='*.test.mjs' -F -- "$base" server/src/ 2>/dev/null); do
      SRV_TESTS="$SRV_TESTS ${t#server/}"
    done
  done
  SRV_TESTS=$(printf '%s\n' $SRV_TESTS | sort -u)

  # THE NATIVE EVALUATOR IS BUILT BEFORE THE SERVER TESTS (2026-11-05). It is a
  # build product, not a committed file; CI builds it in `pretest`. A fresh
  # worktree has none, and the engine tests that load it fail on the missing
  # module rather than on anything the push changed. Build it the same way.
  if [ -n "$SRV_TESTS$SRV_SRC" ] && [ "$SERVER_DEPENDENCY_MODE" = local ] \
     && [ -f server/scripts/build-public-hist215-native.mjs ] \
     && [ ! -f server/native/build/public_hist215_wtl.node ]; then
    echo "[club-arena pre-push] building the native evaluator the server tests load..."
    if ! ( cd server && node scripts/build-public-hist215-native.mjs >/dev/null ); then
      echo "[club-arena pre-push] BLOCKED: the native evaluator did not build."
      FAIL=1
    fi
  fi

  if [ -n "$SRV_TESTS$SRV_SRC" ] && [ "$SERVER_DEPENDENCY_MODE" != local ]; then
    echo "[club-arena pre-push] BLOCKED: required local server dependencies are incomplete."
    echo "  remedy: (cd \"$CA_TREE_TOP/server\" && npm ci --ignore-scripts --no-audit --no-fund)"
    FAIL=1
  elif [ -n "$SRV_TESTS$SRV_SRC" ] && [ ! -x "$SERVER_VITEST" ]; then
    echo ""
    echo "[club-arena pre-push] REFUSING: you changed server/** and there is no vitest"
    echo "                      in server/, so the ENGINE gate cannot run. This is the"
    echo "                      code that deals real hands."
    echo "                      Fix the server dependency installation, then retry."
    echo ""
    FAIL=1
  elif [ -n "$SRV_TESTS" ]; then
    echo "[club-arena pre-push] running the server test files you changed..."
    if ! ( cd server && "$SERVER_VITEST" run $SRV_TESTS ); then
      echo ""
      echo "[club-arena pre-push] BLOCKED: a server test you changed is failing."
      echo "                      auto-deploy-hetzner.yml runs the server suite BEFORE"
      echo "                      it builds, so a red one here does not fail a report -"
      echo "                      it stops the engine deploying at all."
      FAIL=1
    fi
  fi

  # SOURCE CONTRACTS (2026-10-23). `vitest related` only finds tests that
  # IMPORT a changed file. Some laws read server source as TEXT instead: the
  # Horse data ledger scans every noteFire('...') literal in server/src, so a
  # changed file that fires a new telemetry key imports nothing it tests and
  # `related` never selected it. PR #7780 found that out in hosted CI, 35
  # minutes after a green local push. Select those laws here by what the
  # changed file actually contains, so they fail locally first.
  SRV_CONTRACTS=""
  # A changed contract has already run in SRV_TESTS above; select each law once.
  ca_add_contract() {
    case " $(printf '%s ' $SRV_TESTS)$SRV_CONTRACTS " in
      *" $1 "*) ;;
      *) SRV_CONTRACTS="${SRV_CONTRACTS:+$SRV_CONTRACTS }$1" ;;
    esac
  }
  for rel in $SRV_SRC; do
    # Horse telemetry: every fired key must be registered in the Horse data ledger.
    if grep -q "noteFire(" "$CA_TREE_TOP/server/$rel" 2>/dev/null; then
      ca_add_contract src/engine/HorseDataLedger.test.ts
      break
    fi
  done
  # Original hand history is read as text/VM by these contracts, so imports
  # cannot select them. PR #10400 exposed this gap in hosted engine shard 4.
  for rel in $SRV_SRC; do
    if [ "$rel" = src/services/supabase/handHistory.ts ]; then
      ca_add_contract src/engine/OriginalPayloadRetry.test.ts
      ca_add_contract src/engine/LiveHorseDecisionWorkerWiring.guard.test.ts
      break
    fi
  done
  # DECISION DIGESTS (2026-11-07). The policy digests bind every runtime
  # import of HorseLogic and every reference decision source, and their laws
  # read those lists rather than importing the changed file, so `related`
  # never selected them: PR #9817 imported two new engine files into
  # HorseLogic, pushed green, and hosted CI failed it on
  # HorseReferenceDecisionSources.test.ts. Select the digest laws for a change
  # to HorseLogic itself, to the reference-source list, to any file HorseLogic
  # imports, or to any listed reference source.
  CA_DIGEST_LAWS="src/engine/HorseReferenceDecisionSources.test.ts src/engine/aHashedPolicySourceShipsInTheEngineImage.law.test.ts src/engine/HorsePhase10Authority.test.ts src/engine/HorsePhase11PolicyDigest.test.ts src/engine/HorsePhase12PolicyDigest.test.ts src/engine/HorsePhase13PolicyDigest.test.ts"
  CA_HORSE_LOGIC="$CA_TREE_TOP/server/src/engine/HorseLogic.ts"
  CA_REFERENCE_SOURCES="$CA_TREE_TOP/server/src/engine/HorseReferenceDecisionSources.ts"
  for rel in $SRV_SRC; do
    case "$rel" in
      src/engine/*) ca_engine_spec="./${rel#src/engine/}"; ca_engine_spec="${ca_engine_spec%.ts}.js" ;;
      *) ca_engine_spec="" ;;
    esac
    if [ "$rel" = src/engine/HorseLogic.ts ] || [ "$rel" = src/engine/HorseReferenceDecisionSources.ts ] \
      || { [ -n "$ca_engine_spec" ] && grep -qF "from '$ca_engine_spec'" "$CA_HORSE_LOGIC" 2>/dev/null; } \
      || grep -qF "'$rel'" "$CA_REFERENCE_SOURCES" 2>/dev/null; then
      for law in $CA_DIGEST_LAWS; do
        [ -f "$CA_TREE_TOP/server/$law" ] && ca_add_contract "$law"
      done
      break
    fi
  done
  # SOURCE PINS (2026-11-12). A law that pins a method's signature or body
  # reads the source file by PATH (readFileSync, readCurrent, sliceMethod) and
  # imports nothing from it, so `related` never selected it. PR #10631 changed
  # ServerTableEngineSettlement.ts, pushed green, and hosted engine shard 3
  # failed it on ChipContinuity.law.test.ts, which pins postHandTasks by text.
  # Select every server test that names a changed file as a path: the file
  # name with its extension, straight after a slash or an opening quote. An
  # import names the .js specifier, so this stays the tests that read the
  # file, not the whole suite. A harness (.mjs) that reads the changed file
  # is followed one step to the tests that name that harness.
  CA_PIN_PATTERNS=()
  ca_add_pin() {
    CA_PIN_PATTERNS+=(-e "/$1" -e "'$1" -e "\"$1" -e "\`$1")
  }
  for rel in $SRV_SRC; do ca_add_pin "${rel##*/}"; done
  if [ "${#CA_PIN_PATTERNS[@]}" -gt 0 ]; then
    for h in $(grep -rlF --include='*.mjs' "${CA_PIN_PATTERNS[@]}" server/src/ 2>/dev/null); do
      case "$h" in
        *.test.mjs) ;;
        *) ca_add_pin "${h##*/}" ;;
      esac
    done
    for t in $(grep -rlF --include='*.test.ts' --include='*.test.mjs' "${CA_PIN_PATTERNS[@]}" server/src/ 2>/dev/null | sort); do
      ca_add_contract "${t#server/}"
    done
  fi
  if [ "$SERVER_DEPENDENCY_MODE" = local ] && [ -n "$SRV_CONTRACTS" ] && [ -x "$SERVER_VITEST" ]; then
    echo "[club-arena pre-push] running the source-contract laws your server changes touch..."
    if ! ( cd server && "$SERVER_VITEST" run $SRV_CONTRACTS ); then
      echo ""
      echo "[club-arena pre-push] BLOCKED: a source-contract law over your server change failed."
      FAIL=1
    fi
  fi

  if [ "$SERVER_DEPENDENCY_MODE" = local ] && [ -n "$SRV_SRC" ] && [ -x "$SERVER_VITEST" ]; then
    echo "[club-arena pre-push] running the server tests that cover your changes..."
    SERVER_RELATED_ARGS=()
    for tested_file in $SRV_TESTS $SRV_CONTRACTS; do
      SERVER_RELATED_ARGS+=(--exclude "$tested_file")
    done
    if [ -n "$SRV_TESTS$SRV_CONTRACTS" ]; then SERVER_RELATED_ARGS+=(--passWithNoTests); fi
    if ! ( cd server && "$SERVER_VITEST" related --run $SRV_SRC "${SERVER_RELATED_ARGS[@]}" ); then
      echo ""
      echo "[club-arena pre-push] BLOCKED: your engine change breaks a test that covers it."
      echo "                      If the test pins behaviour you deliberately replaced,"
      echo "                      UPDATE it in this same commit."
      FAIL=1
    fi
  fi
fi

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "[club-arena pre-push] FAILED — fix the issues above; release checks have no bypass."
  exit 1
fi

exit 0
