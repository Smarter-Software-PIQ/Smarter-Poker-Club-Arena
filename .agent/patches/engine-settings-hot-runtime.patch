+/**
+ * ENGINE RUNTIME SETTINGS (2026-11-19): load, validate, apply at the hand boundary, fail safe, roll back, audit.
+ */
+import { describe, expect, it } from 'vitest';
+import { horseDecideOptsFromRuntimeSettings, lightningFastFoldTuningFrom } from './apply.js';
+import { RUNTIME_SETTINGS_REGISTRY } from './registry.js';
+import { COMPILED_RUNTIME_SETTINGS, parseRuntimeSettings } from './snapshot.js';
+import { createRuntimeSettingsStore, type RuntimeSettingsUseRow } from './store.js';
+import {
+  LIGHTNING_HORSE_FAST_FOLD_COMPILED_TUNING,
+  lightningHorseFastFoldReactionMs,
+} from '../../lightning/LightningHorse.js';
+import { buildHorseDecisionKey } from '../horseDecision/protocol.js';
+
+const quiet = { warn: () => undefined, log: () => undefined };
+const answer = (version: number, settings: Record<string, unknown>) => ({ version, settings });
+
+describe('parseRuntimeSettings', () => {
+  it('nothing published is the compiled defaults, version 0', () => {
+    expect(parseRuntimeSettings(null)).toEqual({ ok: true, snapshot: COMPILED_RUNTIME_SETTINGS });
+    expect(COMPILED_RUNTIME_SETTINGS.version).toBe(0);
+  });
+
+  it('a partial version keeps the compiled default of every key it leaves out', () => {
+    const r = parseRuntimeSettings(answer(4, { 'lightning.fastFoldMedianMs': 650 }));
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    expect(r.snapshot.version).toBe(4);
+    expect(r.snapshot.values['lightning.fastFoldMedianMs']).toBe(650);
+    for (const spec of RUNTIME_SETTINGS_REGISTRY)
+      if (spec.key !== 'lightning.fastFoldMedianMs')
+        expect(r.snapshot.values[spec.key]).toBe(spec.compiledDefault);
+    expect(Object.isFrozen(r.snapshot.values)).toBe(true);
+  });
+
+  it.each([
+    ['an unknown key', { 'horse.notARealSetting': 1 }, /unknown setting horse.notARealSetting/],
+    ['a value out of range', { 'horse.tournamentFlatBump': 0.3 }, /outside 0..0.2/],
+    ['a value of the wrong kind', { 'horse.v67RiverRaiseShade': '0.2' }, /not a finite number/],
+    ['a fraction for a whole-number key', { 'lightning.fastFoldFloorMs': 450.5 }, /whole number/],
+    [
+      'a broken cross rule',
+      { 'lightning.fastFoldTempoMin': 2, 'lightning.fastFoldTempoMax': 1 },
+      /must not exceed/,
+    ],
+    ['a floor at or above the ceiling', { 'lightning.fastFoldFloorMs': 3000 }, /must be below/],
+  ])('%s refuses the whole version', (_label, settings, reason) => {
+    const r = parseRuntimeSettings(answer(7, settings));
+    expect(r.ok).toBe(false);
+    if (r.ok) return;
+    expect(r.version).toBe(7);
+    expect(r.reason).toMatch(reason);
+  });
+
+  it('a malformed answer is refused', () => {
+    expect(parseRuntimeSettings([]).ok).toBe(false);
+    expect(parseRuntimeSettings({ version: 0, settings: {} }).ok).toBe(false);
+    expect(parseRuntimeSettings({ version: 2, settings: [] }).ok).toBe(false);
+  });
+});
+
+describe('the store', () => {
+  it('a new version lands at the next hand boundary, never inside a hand already dealt', async () => {
+    let next: unknown = answer(1, {});
+    const store = createRuntimeSettingsStore({ read: async () => next, ...quiet });
+    await store.refresh();
+    const handA = store.pinHand('table:t1', '100');
+    expect(handA.version).toBe(1);
+
+    next = answer(2, { 'horse.v67RiverRaiseShade': 0.2 });
+    expect(await store.refresh()).toBe('applied');
+    // the hand in play keeps reading version 1 to its end, however often it asks
+    expect(store.pinHand('table:t1', '100')).toBe(handA);
+    expect(store.pinHand('table:t1', '100').values['horse.v67RiverRaiseShade']).toBe(0.1);
+    // the next hand of that table takes version 2
+    const handB = store.pinHand('table:t1', '101');
+    expect(handB.version).toBe(2);
+    expect(handB.values['horse.v67RiverRaiseShade']).toBe(0.2);
+    expect(store.handVersion('table:t1', '100')).toBe(1);
+    expect(store.handVersion('table:t1', '101')).toBe(2);
+  });
+
+  it('a refused version keeps the last good version serving, and is reported once', async () => {
+    const warns: string[] = [];
+    let next: unknown = answer(3, { 'lightning.fastFoldMedianMs': 700 });
+    const store = createRuntimeSettingsStore({
+      read: async () => next,
+      warn: (m) => warns.push(m),
+      log: () => undefined,
+    });
+    await store.refresh();
+    next = answer(4, { 'lightning.fastFoldMedianMs': 700, 'horse.futureKey': 1 });
+    expect(await store.refresh()).toBe('refused');
+    expect(await store.refresh()).toBe('refused');
+    expect(store.current().version).toBe(3);
+    expect(store.pinHand('table:t', '1').values['lightning.fastFoldMedianMs']).toBe(700);
+    expect(warns.filter((w) => w.includes('refused version 4'))).toHaveLength(1);
+    expect(store.status().lastRefusal?.version).toBe(4);
+  });
+
+  it('a failed or timed-out read keeps the current settings', async () => {
+    let mode: 'ok' | 'throw' | 'hang' = 'ok';
+    const store = createRuntimeSettingsStore({
+      read: () =>
+        mode === 'ok'
+          ? Promise.resolve(answer(5, { 'horse.v65TurnShadeCap': 0.08 }))
+          : mode === 'throw'
+            ? Promise.reject(new Error('connection reset'))
+            : new Promise(() => undefined),
+      readTimeoutMs: 20,
+      ...quiet,
+    });
+    expect(await store.refresh()).toBe('applied');
+    mode = 'throw';
+    expect(await store.refresh()).toBe('failed');
+    mode = 'hang';
+    expect(await store.refresh()).toBe('failed');
+    expect(store.current().version).toBe(5);
+    expect(store.status().consecutiveFailures).toBe(2);
+    mode = 'ok';
+    expect(await store.refresh()).toBe('unchanged');
+    expect(store.status().consecutiveFailures).toBe(0);
+  });
+
+  it('before any good read every hand pins the compiled defaults', async () => {
+    const store = createRuntimeSettingsStore({
+      read: () => Promise.reject(new Error('down')),
+      ...quiet,
+    });
+    await store.refresh();
+    expect(store.pinHand('table:x', '1')).toBe(COMPILED_RUNTIME_SETTINGS);
+    expect(createRuntimeSettingsStore().pinHand('table:y', '1')).toBe(COMPILED_RUNTIME_SETTINGS);
+  });
+
+  it('a rollback is a new version with the old values, applied at the next hand like any other', async () => {
+    let next: unknown = answer(1, {});
+    const store = createRuntimeSettingsStore({ read: async () => next, ...quiet });
+    await store.refresh();
+    next = answer(2, { 'lightning.fastFoldSigma': 0.9 });
+    await store.refresh();
+    expect(store.pinHand('lightning:c1', 'h1').values['lightning.fastFoldSigma']).toBe(0.9);
+    next = answer(3, {});
+    expect(await store.refresh()).toBe('applied');
+    const after = store.pinHand('lightning:c1', 'h2');
+    expect(after.version).toBe(3);
+    expect(after.values).toEqual(COMPILED_RUNTIME_SETTINGS.values);
+  });
+
+  it('audits one row per scope each time the version its hands pin changes, and keeps rows a failed write could not store', async () => {
+    let next: unknown = answer(1, {});
+    const written: RuntimeSettingsUseRow[][] = [];
+    let failWrite = true;
+    const store = createRuntimeSettingsStore({
+      read: async () => next,
+      recordUse: async (rows) => {
+        if (failWrite) throw new Error('db down');
+        written.push([...rows]);
+      },
+      now: () => Date.parse('2026-11-19T21:00:00Z'),
+      ...quiet,
+    });
+    await store.refresh();
+    store.pinHand('table:a', '1');
+    store.pinHand('table:a', '2');
+    store.pinHand('table:a', '3');
+    store.pinHand('table:b', '9');
+    next = answer(2, { 'horse.v68AirShadeScale': 0.5 });
+    await store.refresh();
+    store.pinHand('table:a', '4');
+    store.pinHand('table:a', '5');
+    await store.flushAudit();
+    expect(written).toHaveLength(0);
+    expect(store.status().pendingAuditRows).toBe(3);
+    failWrite = false;
+    await store.flushAudit();
+    expect(written).toEqual([
+      [
+        {
+          scope: 'table:a',
+          hand_id: '1',
+          version: 1,
+          previous_version: null,
+          pinned_at: '2026-11-19T21:00:00.000Z',
+        },
+        {
+          scope: 'table:b',
+          hand_id: '9',
+          version: 1,
+          previous_version: null,
+          pinned_at: '2026-11-19T21:00:00.000Z',
+        },
+        {
+          scope: 'table:a',
+          hand_id: '4',
+          version: 2,
+          previous_version: 1,
+          pinned_at: '2026-11-19T21:00:00.000Z',
+        },
+      ],
+    ]);
+    expect(store.status().pendingAuditRows).toBe(0);
+  });
+
+  it('start reads once at once and stop ends the polling', async () => {
+    let reads = 0;
+    const store = createRuntimeSettingsStore({
+      read: async () => {
+        reads += 1;
+        return answer(1, {});
+      },
+      intervalMs: 60_000,
+      ...quiet,
+    });
+    await store.start();
+    expect(reads).toBe(1);
+    expect(store.current().version).toBe(1);
+    store.stop();
+  });
+});
+
+describe('where the settings are read', () => {
+  it('at the compiled defaults the Horse decision gets no options at all, so its request and key are unchanged', () => {
+    expect(horseDecideOptsFromRuntimeSettings(COMPILED_RUNTIME_SETTINGS)).toBeUndefined();
+    expect(horseDecideOptsFromRuntimeSettings(undefined)).toBeUndefined();
+    expect(lightningFastFoldTuningFrom(undefined)).toEqual(
+      LIGHTNING_HORSE_FAST_FOLD_COMPILED_TUNING
+    );
+    const v1 = parseRuntimeSettings(
+      answer(
+        1,
+        Object.fromEntries(RUNTIME_SETTINGS_REGISTRY.map((s) => [s.key, s.compiledDefault]))
+      )
+    );
+    expect(v1.ok && horseDecideOptsFromRuntimeSettings(v1.snapshot)).toBeUndefined();
+  });
+
+  it('a changed Horse parameter is passed as its decision option, and only that one', () => {
+    const r = parseRuntimeSettings(
+      answer(2, {
+        'horse.v65TurnShadeCap': 0.08,
+        'horse.tournamentFlatBump': 0.06,
+        'lightning.fastFoldSigma': 0.7,
+      })
+    );
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    const opts = horseDecideOptsFromRuntimeSettings(r.snapshot);
+    expect(opts).toEqual({ v65TurnShadeCapOverride: 0.08, tournamentFlatBump: 0.06 });
+    // the decision key binds the options, so a replay of the journaled request is exact
+    const base = {
+      fence: 'f',
+      decisionTimeMs: 0,
+      player: { user_id: 'u' } as never,
+      gameState: { stage: 'turn' } as never,
+    };
+    expect(buildHorseDecisionKey({ ...base, opts })).not.toBe(buildHorseDecisionKey(base));
+  });
+
+  it('the Lightning fast-fold timing at the compiled defaults is exactly the compiled tuning, draw for draw', () => {
+    expect(lightningFastFoldTuningFrom(COMPILED_RUNTIME_SETTINGS)).toEqual(
+      LIGHTNING_HORSE_FAST_FOLD_COMPILED_TUNING
+    );
+    const seq = (seed: number) => {
+      let x = seed;
+      return () => (x = (x * 1103515245 + 12345) % 2 ** 31) / 2 ** 31;
+    };
+    for (let i = 0; i < 200; i++) {
+      const userId = `horse-${i}`;
+      expect(
+        lightningHorseFastFoldReactionMs({
+          userId,
+          random: seq(i + 1),
+          tuning: lightningFastFoldTuningFrom(COMPILED_RUNTIME_SETTINGS),
+        })
+      ).toBe(lightningHorseFastFoldReactionMs({ userId, random: seq(i + 1) }));
+    }
+  });
+
+  it('a published Lightning timing moves the draw inside its own floor and ceiling', () => {
+    const r = parseRuntimeSettings(
+      answer(9, { 'lightning.fastFoldFloorMs': 900, 'lightning.fastFoldMaxMs': 1000 })
+    );
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    const tuning = lightningFastFoldTuningFrom(r.snapshot);
+    for (let i = 0; i < 100; i++) {
+      const ms = lightningHorseFastFoldReactionMs({ userId: `h${i}`, random: Math.random, tuning });
+      expect(ms).toBeGreaterThanOrEqual(900);
+      expect(ms).toBeLessThanOrEqual(1000);
+    }
+  });
+});
diff --git a/server/src/engine/runtimeSettings/snapshot.ts b/server/src/engine/runtimeSettings/snapshot.ts
new file mode 100644
index 00000000000..0b146487173
--- /dev/null
+++ b/server/src/engine/runtimeSettings/snapshot.ts
@@ -0,0 +1,87 @@
+/**
+ * ENGINE RUNTIME SETTINGS, ONE VERSION (2026-11-19). A snapshot is one validated, frozen settings version: every
+ * registered key with a value (a key the version does not publish keeps its compiled default). The engine holds one
+ * snapshot per hand for the whole hand (store.ts pinHand), so a published change never lands mid-hand.
+ */
+import {
+  RUNTIME_SETTINGS_CROSS_RULES,
+  RUNTIME_SETTINGS_REGISTRY,
+  compiledRuntimeSettingValues,
+  runtimeSettingSpec,
+  type RuntimeSettingValues,
+} from './registry.js';
+
+export interface RuntimeSettingsSnapshot {
+  /** 0 is the compiled defaults (nothing read yet, or nothing published); a database version is 1 or more. */
+  readonly version: number;
+  readonly source: 'compiled' | 'database';
+  readonly values: RuntimeSettingValues;
+}
+
+export const COMPILED_RUNTIME_SETTINGS: RuntimeSettingsSnapshot = Object.freeze({
+  version: 0,
+  source: 'compiled',
+  values: compiledRuntimeSettingValues(),
+});
+
+export type RuntimeSettingsParse =
+  | { ok: true; snapshot: RuntimeSettingsSnapshot }
+  | { ok: false; version: number | null; reason: string };
+
+/** A published settings object alone (no version): every key registered, every value of its kind and in range. */
+export function validateRuntimeSettingValues(
+  settings: unknown
+): { ok: true; values: RuntimeSettingValues } | { ok: false; reason: string } {
+  if (!settings || typeof settings !== 'object' || Array.isArray(settings))
+    return { ok: false, reason: 'settings is not a JSON object' };
+  const values: Record<string, number> = { ...compiledRuntimeSettingValues() };
+  for (const [key, raw] of Object.entries(settings as Record<string, unknown>)) {
+    const spec = runtimeSettingSpec(key);
+    if (!spec)
+      return { ok: false, reason: `unknown setting ${key}: this engine does not register it` };
+    if (typeof raw !== 'number' || !Number.isFinite(raw))
+      return { ok: false, reason: `${key} is not a finite number` };
+    if (spec.kind === 'integer' && !Number.isSafeInteger(raw))
+      return { ok: false, reason: `${key} must be a whole number` };
+    if (raw < spec.min || raw > spec.max)
+      return { ok: false, reason: `${key}=${raw} is outside ${spec.min}..${spec.max}` };
+    values[key] = raw;
+  }
+  for (const rule of RUNTIME_SETTINGS_CROSS_RULES) {
+    const refusal = rule(values);
+    if (refusal) return { ok: false, reason: refusal };
+  }
+  // registry order, frozen
+  return {
+    ok: true,
+    values: Object.freeze(
+      Object.fromEntries(RUNTIME_SETTINGS_REGISTRY.map((s) => [s.key, values[s.key]!]))
+    ),
+  };
+}
+
+/**
+ * The database answer of fn_ca_engine_runtime_settings_current(): `{ version: <int >= 1>, settings: {...} }`, or null
+ * when nothing is published. null parses to the compiled defaults. Anything else that is not exactly valid is refused
+ * whole; the caller keeps serving its last good snapshot.
+ */
+export function parseRuntimeSettings(answer: unknown): RuntimeSettingsParse {
+  if (answer === null || answer === undefined)
+    return { ok: true, snapshot: COMPILED_RUNTIME_SETTINGS };
+  if (typeof answer !== 'object' || Array.isArray(answer))
+    return { ok: false, version: null, reason: 'the answer is not a JSON object' };
+  const a = answer as Record<string, unknown>;
+  const version = a.version;
+  if (!Number.isSafeInteger(version) || (version as number) < 1)
+    return { ok: false, version: null, reason: 'the version is not a whole number of 1 or more' };
+  const checked = validateRuntimeSettingValues(a.settings);
+  if (!checked.ok) return { ok: false, version: version as number, reason: checked.reason };
+  return {
+    ok: true,
+    snapshot: Object.freeze({
+      version: version as number,
+      source: 'database',
+      values: checked.values,
+    }),
+  };
+}
diff --git a/server/src/engine/runtimeSettings/store.ts b/server/src/engine/runtimeSettings/store.ts
new file mode 100644
index 00000000000..90c1b291492
--- /dev/null
+++ b/server/src/engine/runtimeSettings/store.ts
@@ -0,0 +1,261 @@
+/**
+ * ENGINE RUNTIME SETTINGS, THE STORE (2026-11-19). One per engine process.
+ *
+ *   database: fn_ca_engine_runtime_settings_current()   (read every RUNTIME_SETTINGS_POLL_MS)
+ *     -> parseRuntimeSettings (snapshot.ts): every key registered, every value in range, or the version is refused
+ *       -> `active`: the snapshot the NEXT hand will take
+ *         -> pinHand(scope, handId) at each hand start: that hand reads that snapshot to its end
+ *
+ * AT A HAND BOUNDARY, NEVER MID-HAND. A new version only replaces `active`. A hand already dealt holds the snapshot it
+ * pinned when it started; the next hand of that table pins the new one. So a change is atomic per hand: no hand ever
+ * reads two versions.
+ *
+ * FAIL SAFE: THE LAST GOOD VERSION KEEPS SERVING.
+ * - The read fails, times out or the function is missing: `active` is unchanged (before any good read that is the
+ *   compiled defaults, version 0).
+ * - The read returns a version this engine refuses (an unknown key, a value of the wrong kind or out of range, a
+ *   broken cross rule): `active` is unchanged and the refusal is reported once per refused version.
+ * - Nothing is published (the function answers null): the compiled defaults.
+ *
+ * AUDIT. When a scope (one table, or one Lightning Cluster) pins a version different from the one it pinned before,
+ * one row {scope, hand_id, version, previous_version, pinned_at} is queued and written in a batch through
+ * fn_ca_engine_runtime_settings_record_use. A hand used the version of the latest row of its scope at or before it
+ * (hand numbers order a table; pinned_at orders a Cluster). The last RECENT_HANDS pins are also kept in memory
+ * (handVersion) for diagnostics. A failed write keeps its rows for the next tick, bounded by AUDIT_QUEUE_MAX.
+ */
+import {
+  COMPILED_RUNTIME_SETTINGS,
+  parseRuntimeSettings,
+  type RuntimeSettingsSnapshot,
+} from './snapshot.js';
+
+export const RUNTIME_SETTINGS_POLL_MS = 30_000;
+export const RUNTIME_SETTINGS_READ_TIMEOUT_MS = 5_000;
+const AUDIT_QUEUE_MAX = 5_000;
+const AUDIT_BATCH_MAX = 500;
+const SCOPES_MAX = 50_000;
+const RECENT_HANDS = 4_096;
+const WARN_EVERY_MS = 10 * 60_000;
+
+export interface RuntimeSettingsUseRow {
+  scope: string;
+  hand_id: string;
+  version: number;
+  previous_version: number | null;
+  pinned_at: string;
+}
+
+export type RuntimeSettingsRefreshOutcome = 'applied' | 'unchanged' | 'refused' | 'failed';
+
+export interface RuntimeSettingsStoreDeps {
+  /** Reads the database answer. Absent: the store never reads and serves the compiled defaults. */
+  read?: () => Promise<unknown>;
+  /** Writes audit rows. Absent: rows are kept in memory only. */
+  recordUse?: (rows: readonly RuntimeSettingsUseRow[]) => Promise<void>;
+  now?: () => number;
+  warn?: (message: string) => void;
+  log?: (message: string) => void;
+  intervalMs?: number;
+  readTimeoutMs?: number;
+}
+
+export interface RuntimeSettingsStatus {
+  activeVersion: number;
+  activeSource: 'compiled' | 'database';
+  lastReadAt: number | null;
+  lastReadOutcome: RuntimeSettingsRefreshOutcome | null;
+  lastRefusal: { version: number | null; reason: string } | null;
+  consecutiveFailures: number;
+  pendingAuditRows: number;
+}
+
+export interface RuntimeSettingsStore {
+  /** The snapshot the next hand will take. */
+  current(): RuntimeSettingsSnapshot;
+  /** Pin the snapshot a hand reads to its end. The same (scope, handId) again returns the same pin. */
+  pinHand(scope: string, handId: string): RuntimeSettingsSnapshot;
+  /** The version a recent hand pinned (in memory, last RECENT_HANDS pins), or undefined. */
+  handVersion(scope: string, handId: string): number | undefined;
+  refresh(): Promise<RuntimeSettingsRefreshOutcome>;
+  flushAudit(): Promise<void>;
+  /** Replace the database reader and audit writer (the production attach), keeping every pin. */
+  attach(io: Pick<RuntimeSettingsStoreDeps, 'read' | 'recordUse'>): void;
+  /** First read, then a read every intervalMs. Resolves after the first read (whatever its outcome). */
+  start(): Promise<void>;
+  stop(): void;
+  status(): RuntimeSettingsStatus;
+}
+
+export function createRuntimeSettingsStore(
+  deps: RuntimeSettingsStoreDeps = {}
+): RuntimeSettingsStore {
+  const now = deps.now ?? (() => Date.now());
+  const warn = deps.warn ?? ((m: string) => console.warn(m));
+  const log = deps.log ?? ((m: string) => console.log(m));
+  const intervalMs = deps.intervalMs ?? RUNTIME_SETTINGS_POLL_MS;
+  const readTimeoutMs = deps.readTimeoutMs ?? RUNTIME_SETTINGS_READ_TIMEOUT_MS;
+  let read = deps.read;
+  let recordUse = deps.recordUse;
+  let active: RuntimeSettingsSnapshot = COMPILED_RUNTIME_SETTINGS;
+  const pins = new Map<string, { handId: string; snapshot: RuntimeSettingsSnapshot }>();
+  const recent = new Map<string, number>();
+  let queue: RuntimeSettingsUseRow[] = [];
+  let lastReadAt: number | null = null;
+  let lastReadOutcome: RuntimeSettingsRefreshOutcome | null = null;
+  let lastRefusal: { version: number | null; reason: string } | null = null;
+  let refusedVersionReported: number | null | undefined;
+  let failures = 0;
+  let lastFailWarn = Number.NEGATIVE_INFINITY;
+  let inFlight: Promise<RuntimeSettingsRefreshOutcome> | null = null;
+  let flushing: Promise<void> | null = null;
+  let timer: ReturnType<typeof setInterval> | null = null;
+
+  const once = async (): Promise<RuntimeSettingsRefreshOutcome> => {
+    if (!read) return 'unchanged';
+    let deadline: ReturnType<typeof setTimeout> | null = null;
+    let answer: unknown;
+    try {
+      answer = await Promise.race([
+        read(),
+        new Promise<never>((_, reject) => {
+          deadline = setTimeout(
+            () => reject(new Error('runtime settings read timed out')),
+            readTimeoutMs
+          );
+          (deadline as { unref?: () => void }).unref?.();
+        }),
+      ]);
+    } catch (error) {
+      failures += 1;
+      const at = now();
+      if (failures === 1 || at - lastFailWarn >= WARN_EVERY_MS) {
+        lastFailWarn = at;
+        warn(
+          `[EngineRuntimeSettings] read failed (${failures} in a row); version ${active.version} keeps serving: ` +
+            (error instanceof Error ? error.message : String(error))
+        );
+      }
+      return 'failed';
+    } finally {
+      if (deadline) clearTimeout(deadline);
+    }
+    lastReadAt = now();
+    if (failures > 0) log(`[EngineRuntimeSettings] reads again after ${failures} failed read(s)`);
+    failures = 0;
+    const parsed = parseRuntimeSettings(answer);
+    if (!parsed.ok) {
+      lastRefusal = { version: parsed.version, reason: parsed.reason };
+      if (refusedVersionReported !== parsed.version) {
+        refusedVersionReported = parsed.version;
+        warn(
+          `[EngineRuntimeSettings] refused version ${parsed.version ?? '(unreadable)'}: ${parsed.reason}; ` +
+            `version ${active.version} keeps serving`
+        );
+      }
+      return 'refused';
+    }
+    if (parsed.snapshot.version === active.version) return 'unchanged';
+    const previous = active.version;
+    active = parsed.snapshot;
+    lastRefusal = null;
+    refusedVersionReported = undefined;
+    log(
+      `[EngineRuntimeSettings] version ${active.version} accepted (was ${previous}); ` +
+        'each table takes it at its next hand'
+    );
+    return 'applied';
+  };
+
+  const flush = async (): Promise<void> => {
+    if (!recordUse || queue.length === 0) return;
+    const batch = queue.slice(0, AUDIT_BATCH_MAX);
+    try {
+      await recordUse(batch);
+      queue = queue.slice(batch.length);
+    } catch (error) {
+      const at = now();
+      if (at - lastFailWarn >= WARN_EVERY_MS) {
+        lastFailWarn = at;
+        warn(
+          `[EngineRuntimeSettings] the hand-use audit could not be written (${queue.length} row(s) kept): ` +
+            (error instanceof Error ? error.message : String(error))
+        );
+      }
+    }
+  };
+
+  const store: RuntimeSettingsStore = {
+    current: () => active,
+    pinHand(scope, handId) {
+      const prior = pins.get(scope);
+      if (prior && prior.handId === handId) return prior.snapshot;
+      const snapshot = active;
+      if (prior) pins.delete(scope);
+      else if (pins.size >= SCOPES_MAX) pins.delete(pins.keys().next().value as string);
+      pins.set(scope, { handId, snapshot });
+      const recentKey = `${scope}\u0000${handId}`;
+      recent.delete(recentKey);
+      recent.set(recentKey, snapshot.version);
+      if (recent.size > RECENT_HANDS) recent.delete(recent.keys().next().value as string);
+      if (!prior || prior.snapshot.version !== snapshot.version) {
+        if (queue.length >= AUDIT_QUEUE_MAX) queue.shift();
+        queue.push({
+          scope,
+          hand_id: handId,
+          version: snapshot.version,
+          previous_version: prior ? prior.snapshot.version : null,
+          pinned_at: new Date(now()).toISOString(),
+        });
+      }
+      return snapshot;
+    },
+    handVersion: (scope, handId) => recent.get(`${scope}\u0000${handId}`),
+    refresh() {
+      if (inFlight) return inFlight;
+      inFlight = once()
+        .then((outcome) => {
+          lastReadOutcome = outcome;
+          return outcome;
+        })
+        .finally(() => {
+          inFlight = null;
+        });
+      return inFlight;
+    },
+    flushAudit() {
+      if (flushing) return flushing;
+      flushing = flush().finally(() => {
+        flushing = null;
+      });
+      return flushing;
+    },
+    attach(io) {
+      if (io.read) read = io.read;
+      if (io.recordUse) recordUse = io.recordUse;
+    },
+    async start() {
+      if (timer) return;
+      timer = setInterval(() => {
+        void store.refresh().catch(() => undefined);
+        void store.flushAudit().catch(() => undefined);
+      }, intervalMs);
+      (timer as { unref?: () => void }).unref?.();
+      await store.refresh().catch(() => undefined);
+    },
+    stop() {
+      if (timer) clearInterval(timer);
+      timer = null;
+      void store.flushAudit().catch(() => undefined);
+    },
+    status: () => ({
+      activeVersion: active.version,
+      activeSource: active.source,
+      lastReadAt,
+      lastReadOutcome,
+      lastRefusal,
+      consecutiveFailures: failures,
+      pendingAuditRows: queue.length,
+    }),
+  };
+  return store;
+}
