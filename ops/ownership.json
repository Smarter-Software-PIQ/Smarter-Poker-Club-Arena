{
  "$comment": [
    "CODE-AREA OWNERSHIP MAP (Dan, 2026-11-19 17:26 Chicago). Read by scripts/ci/ownership-check.mjs on every pull request (.github/workflows/ownership-map.yml).",
    "Why: on 2026-11-19 three agents rewrote the same database function (fn_ca_alarm_drill) in three open pull requests and each merge overwrote the last.",
    "A pull request names its lane with a line 'Lane: <lane-id>' in its description. The check comments and warns when a pull request touches a path or database function owned by another lane, or a database function another OPEN pull request also defines. It fails only when a pull request touches a locked area without declaring that area's lane.",
    "Areas are matched in order: the first area whose pattern matches owns the path or function. Path patterns: '**' crosses directories, '*' stays inside one. Function patterns: '*' matches any run of characters. Names are compared without schema and in lower case.",
    "Seeded from AGENTS.md (engine release custody), CLAUDE.md sections 1, 2 and 13, docs/reliability-controller/RECOVERY-OWNERSHIP-MAP.md (sections 1a to 1d), docs/ENGINE-RELEASE-RUNBOOK.md and PUBLISHING.md. Add a lane or an area here in the same pull request that creates new owned code."
  ],
  "version": 1,
  "lanes": {
    "release-custody": {
      "description": "Engine release controls: staging, certification, cutover transaction, seal, rollback, Backup engine and the owner windows. One custodian at a time (AGENTS.md).",
      "sources": [
        "AGENTS.md",
        "docs/ENGINE-RELEASE-RUNBOOK.md",
        "docs/reliability-controller/RECOVERY-OWNERSHIP-MAP.md"
      ]
    },
    "migration-install": {
      "description": "How merged migrations reach production: Apply Merged Migration, its dispatcher and the applied-migration ledger.",
      "sources": ["CLAUDE.md", "PUBLISHING.md"]
    },
    "engine-maintenance": {
      "description": "The daily 04:00-06:00 Chicago maintenance window, maintenance breaks, freeze and thaw.",
      "sources": ["CLAUDE.md", "docs/reliability-controller/RECOVERY-OWNERSHIP-MAP.md"]
    },
    "reliability-controller": {
      "description": "Reliability Controller: incident intake, classification, escalation, notification and automatic runbooks.",
      "sources": ["docs/reliability-controller/RECOVERY-OWNERSHIP-MAP.md"]
    },
    "alarms-and-watches": {
      "description": "Production alarms, watches and drills: cron health, cron failure watch, hand-gap watch, engine cutover watch, alarm drills and the operational alert ledger.",
      "sources": ["docs/reliability-controller/RECOVERY-OWNERSHIP-MAP.md"]
    },
    "daily-digest": {
      "description": "The Smarter.Poker daily operations digest and every digest helper.",
      "sources": ["docs/reliability-controller/RECOVERY-OWNERSHIP-MAP.md"]
    },
    "ci-and-agent-tooling": {
      "description": "Agent push route, pre-push hook, CI guards, migration version tooling, the heavy-job queue and this ownership map.",
      "sources": ["PUBLISHING.md", "CLAUDE.md"]
    },
    "horse-brain": {
      "description": "Horse decision engine, GTO/V31 solver data, Horse rosters and training.",
      "sources": ["CLAUDE.md"]
    },
    "lightning": {
      "description": "Lightning pooled fast-fold cash: clusters, pools, matcher and its client.",
      "sources": ["CLAUDE.md"]
    },
    "tournaments": {
      "description": "Tournament lifecycle: registration, launch, Spins, Sit and Gos, satellites, bounties, payouts.",
      "sources": ["CLAUDE.md"]
    },
    "money-and-accounting": {
      "description": "Chip accounting: ledger, escrow, mint, cashier, union wallets, rake, rakeback, promo, BBJ and cash-outs.",
      "sources": ["CLAUDE.md"]
    },
    "diamond": {
      "description": "Diamond economy, Diamond Arena (closed) and Diamond games.",
      "sources": ["CLAUDE.md"]
    },
    "table-engine": {
      "description": "The poker engine on the Hetzner host: table engines, dealing, settlement, GameServer.",
      "sources": ["CLAUDE.md", "docs/reliability-controller/RECOVERY-OWNERSHIP-MAP.md"]
    },
    "club-arena-client": {
      "description": "The Club Arena web client.",
      "sources": ["CLAUDE.md"]
    }
  },
  "areas": [
    {
      "lane": "release-custody",
      "locked": true,
      "why": "Release controls. A change here can replace or roll back the live engine; the custodian owns it alone.",
      "paths": [
        "server/release/**",
        "server/release-evidence/**",
        "server/scripts/engine-release-*",
        "server/scripts/engine-supervisor.sh",
        "server/src/maintenance/maintenanceSchedulePolicy.json",
        "scripts/release/**",
        "operations/release/**",
        ".github/workflows/auto-deploy-hetzner.yml",
        ".github/workflows/stage-engine-release.yml",
        ".github/workflows/evening-release-plan.yml",
        ".github/workflows/backup-engine.yml",
        ".github/workflows/engine-drill.yml",
        ".github/workflows/engine-rollback-drill.yml"
      ],
      "functions": [
        "fn_ca_release_freeze_refuses_mgmt_api_ddl",
        "ca_release_schema_freeze_holds",
        "fn_ca_release_claim",
        "release_engine_leadership"
