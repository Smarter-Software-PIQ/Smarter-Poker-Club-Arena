-- Per-opponent prior, strictly before each decision's hand. Read-only. {{PAIRS}} = ('uuid'::uuid, asof_ms::bigint),... ; tested 2026-11-13: 4 humans, 3,268 rows, 21 ms execution (index idx_ca_hand_facts_user_time); statement_timeout 25 s; if it times out the affected witnesses are classed UNVERIFIED, never unknown.
set statement_timeout='25s';
with q(user_id, asof_ms) as (values {{PAIRS}}),
f as (select q.user_id, q.asof_ms, to_timestamp(q.asof_ms/1000.0) asof, case when x.game_variant ilike '%8%' then 'hilo' when x.game_variant ilike 'plo%' then 'omaha' when x.game_variant ilike 'flh%' then 'limit' else 'holdem' end fam, (x.tournament_id is not null) trn, x.played_at, x.vpip, x.pfr, x.players_dealt,
  coalesce(x.aggressive_actions_flop,0)+coalesce(x.aggressive_actions_turn,0)+coalesce(x.aggressive_actions_river,0) ag, coalesce(x.passive_actions_flop,0)+coalesce(x.passive_actions_turn,0)+coalesce(x.passive_actions_river,0) pa
 from q join public.ca_hand_facts x on x.user_id=q.user_id and x.played_at < to_timestamp(q.asof_ms/1000.0) and x.played_at >= to_timestamp(q.asof_ms/1000.0) - interval '14 days')
select jsonb_agg(r) from (select user_id, fam, trn, asof_ms, count(*) n, count(*) filter (where played_at >= timestamptz '2026-11-13T08:08:00Z') n_post_repair, round(avg(vpip::int),4)::float vpip, round(avg(pfr::int),4)::float pfr, round(avg((players_dealt>=6)::int),2)::float six, round(sum(ag)::numeric/nullif(sum(ag+pa),0),4)::float rate, (extract(epoch from max(played_at))*1000)::bigint last_at_ms,
 count(*) filter (where played_at >= asof - interval '24 hours') n24, round(avg(vpip::int) filter (where played_at >= asof - interval '24 hours'),4)::float v24, round((sum(ag) filter (where played_at >= asof - interval '24 hours'))::numeric/nullif(sum(ag+pa) filter (where played_at >= asof - interval '24 hours'),0),4)::float r24,
 count(*) filter (where played_at < asof - interval '24 hours') nold, round(avg(vpip::int) filter (where played_at < asof - interval '24 hours'),4)::float vold, round((sum(ag) filter (where played_at < asof - interval '24 hours'))::numeric/nullif(sum(ag+pa) filter (where played_at < asof - interval '24 hours'),0),4)::float rold
 from f group by 1,2,3,4) r;
