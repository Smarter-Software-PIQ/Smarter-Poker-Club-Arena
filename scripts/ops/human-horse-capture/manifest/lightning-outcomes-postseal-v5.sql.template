-- Post-seal protocol v5 addendum: terminal outcome of every Lightning hand FORMED in the slice. Read-only, one statement, one attempt per 1-minute slice.
-- Placeholders: {{START_UTC}} {{END_UTC}}. No chips are read; status never implies chip movement.
BEGIN READ ONLY;
SET LOCAL statement_timeout='10000ms';
SELECT row_to_json(q) FROM (
 SELECT l.hand_id AS lightning_hand_id, l.hand_history_id, l.formed_at, (l.settled_at IS NOT NULL) AS settled, (l.voided_at IS NOT NULL) AS voided,
  (l.hand_number IS NOT NULL) AS numbered, split_part(regexp_replace(coalesce(l.void_reason,''),'^reconciled [0-9-]+: ',''),':',1) AS void_reason_class,
  i.state AS instance_state, (h.id IS NOT NULL) AS history_row_present
 FROM (SELECT * FROM public.lightning_hand WHERE formed_at >= '{{START_UTC}}'::timestamptz AND formed_at < '{{END_UTC}}'::timestamptz ORDER BY formed_at,hand_id LIMIT 6001) l
 LEFT JOIN public.lightning_instance i ON i.id=l.lightning_instance_id
 LEFT JOIN public.hand_history h ON h.id=l.hand_history_id
) q;
COMMIT;
