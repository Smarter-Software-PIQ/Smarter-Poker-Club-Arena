-- Post-seal protocol v5 addendum 2 complete-window slice reader (denominators). Speed: recorded value when it agrees with the per-hand lightning_hand link; when the header has no public_memory_domain (ordinary cash showdown hands) the link decides; disagreement = unknown. Read-only, one statement, 10 s timeout, one attempt per 1-minute slice.
-- Placeholders: {{START_UTC}} {{END_UTC}} {{SOURCE_SHA}}. Every committed header in the slice, all variants, with roster Horse flags.
BEGIN READ ONLY;
SET LOCAL statement_timeout='10000ms';
SELECT row_to_json(q) FROM (
 SELECT h.id AS hand_id,h.game_variant,(h.tournament_id IS NOT NULL) AS tournament,h.has_human,h.created_at,
  CASE WHEN h.public_memory_domain->>'version'='1' AND h.public_memory_domain->>'speed' IN ('table','lightning') THEN
        CASE WHEN (h.public_memory_domain->>'speed'='lightning') = EXISTS (SELECT 1 FROM public.lightning_hand lh WHERE lh.hand_history_id=h.id) THEN h.public_memory_domain->>'speed' ELSE 'unknown' END
       WHEN h.public_memory_domain IS NULL AND h.tournament_id IS NULL THEN
        CASE WHEN EXISTS (SELECT 1 FROM public.lightning_hand lh WHERE lh.hand_history_id=h.id) THEN 'lightning' ELSE 'table' END
       ELSE 'unknown' END AS original_speed,
  CASE WHEN h.public_memory_domain->>'version'='1' AND h.public_memory_domain->>'speed' IN ('table','lightning') THEN
        CASE WHEN (h.public_memory_domain->>'speed'='lightning') = EXISTS (SELECT 1 FROM public.lightning_hand lh WHERE lh.hand_history_id=h.id) THEN 'recorded' ELSE 'contradictory_recorded_vs_lightning_link' END
       WHEN h.public_memory_domain IS NULL AND h.tournament_id IS NULL THEN 'resolved_by_lightning_link'
       ELSE 'unknown' END AS speed_source,
  CASE WHEN c.hand_id IS NULL THEN 'no_commit_row'
       WHEN c.post_commit_completed_at IS NULL THEN 'post_commit_pending'
       WHEN c.post_commit_payload#>>'{accepted_hand_facts,horse_accepted_terminal,sourceRelease}'='{{SOURCE_SHA}}' THEN 'accepted_terminal_sealed_source'
       WHEN c.post_commit_payload#>>'{accepted_hand_facts,horse_accepted_terminal,sourceRelease}' IS NOT NULL THEN 'accepted_terminal_other_source'
       WHEN c.post_commit_payload#>>'{accepted_hand_facts,horse_journal_identity,version}'='1' THEN 'lightning_journal_identity'
       ELSE 'no_horse_binding' END AS binding,
  CASE WHEN jsonb_typeof(h.players)='array' THEN (SELECT jsonb_agg(jsonb_build_object('userId',m->>'userId','is_horse',p.is_horse))
   FROM jsonb_array_elements(h.players) m LEFT JOIN public.profiles p ON p.id::text = m->>'userId') END AS roster
 FROM (SELECT * FROM public.hand_history WHERE created_at >= '{{START_UTC}}'::timestamptz AND created_at < '{{END_UTC}}'::timestamptz ORDER BY created_at,id LIMIT 6001) h
 LEFT JOIN public.hand_atomic_commits c ON c.hand_id=h.id
) q;
COMMIT;
