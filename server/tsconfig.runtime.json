{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "isolatedModules": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.mts",
    "src/**/*.test.cts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.spec.mts",
    "src/**/*.spec.cts",
    "src/**/*.test-support.*",
    "src/**/__tests__/**",
    "src/testing/**",
    "src/engine/testing/**",
    "src/benchmark/fixtures/**",
    "src/benchmark/Sparring*.ts",
    "src/benchmark/sparringRun.ts"
  ]
}
